@model IEnumerable<LibraryMangement.Models.MaterialViewModel>

@{
    Layout = "~/Views/Shared/_PatronLayout.cshtml";
    ViewBag.Title = "My Cart";
}

<h2>My Cart</h2>

@using (Html.BeginForm("CheckoutSelected", "Patron", FormMethod.Post))
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Select</th>
                <th>Title</th>
               @* <th>Author</th>*@
                <th>Edition</th>
                <th>YearPublished</th>
                <th>Remove</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var material in Model)
            {
                <tr>
                    <td>
                        <input type="checkbox" name="SelectedMaterialIDs" value="@material.MaterialID" checked />
                    </td>
                    <td>@material.Title</td>
                 @*   <td>@material.Author.Name</td>*@
                    <td>@material.Edition</td>
                    <td>@material.YearPublished</td>
                    <td>
                        <a class="btn btn-danger btn-sm" href="@Url.Action("RemoveFromCart", new { id = material.MaterialID })">Remove</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">
        <i class="bi bi-cart-check me-1"></i> Checkout
    </button>
}
