@model LibraryMangement.Models.PatronDashboardViewModel

@{
    Layout = "~/Views/Shared/_PatronLayout.cshtml";
    ViewBag.Title = "Patron Dashboard";
}

<h2>Welcome, @Model.PatronName</h2>

<div class="row mb-4">
    <div class="row g-3 mb-4">
        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("PatronDashboard", "Patron")" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center p-2 h-100 hover-card">
                    <div class="card-body">
                        <div class="mb-1">
                            <i class="bi bi-book fs-2 text-secondary"></i>
                        </div>
                        <h6 class="text-uppercase fw-semibold small mb-1">Total Active Issued</h6>
                        <h4 class="fw-bold mb-2">@Model.ActiveIssuedCount</h4>
                        <span class="text-primary small fw-semibold">View Details →</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("OverdueList", "Patron")" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center p-2 h-100 hover-card">
                    <div class="card-body">
                        <div class="mb-1">
                            <i class="bi bi-exclamation-triangle fs-2 text-secondary"></i>
                        </div>
                        <h6 class="text-uppercase fw-semibold small mb-1">Overdue Items</h6>
                        <h4 class="fw-bold mb-2">@Model.OverdueCount</h4>
                        <span class="text-primary small fw-semibold">View Details →</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("MyReservations", "Patron")" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center p-2 h-100 hover-card">
                    <div class="card-body">
                        <div class="mb-1">
                            <i class="bi bi-calendar-check fs-2 text-secondary"></i>
                        </div>
                        <h6 class="text-uppercase fw-semibold small mb-1">Pending Reservations</h6>
                        <h4 class="fw-bold mb-2">@Model.PendingReservations</h4>
                        <span class="text-primary small fw-semibold">View Details →</span>
                    </div>
                </div>
            </a>
        </div>

        <div class="col-md-3 col-sm-6">
            <a href="@Url.Action("MyBookingList", "Patron")" class="text-decoration-none">
                <div class="card shadow-sm border-0 text-center p-2 h-100 hover-card">
                    <div class="card-body">
                        <div class="mb-1">
                            <i class="bi bi-clock-history fs-2 text-secondary"></i>
                        </div>
                        <h6 class="text-uppercase fw-semibold small mb-1">Pending Bookings</h6>
                        <h4 class="fw-bold mb-2">@Model.PendingBookings</h4>
                        <span class="text-primary small fw-semibold">View Details →</span>
                    </div>
                </div>
            </a>
        </div>
    </div>


</div>


<h3>Active Issued Materials</h3>
<div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
    <table class="table table-striped mb-0">
        <thead class="table-light sticky-top">
            <tr>
                <th>Title</th>
                <th>Account Number</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var issue in Model.ActiveIssues)
            {
                string statusColor = issue.Status == "Issued" ? "green" :
                                     issue.Status == "Overdue" ? "red" : "black";

                <tr>
                    <td>@issue.MaterialCopy.Material.Title</td>
                    <td>@issue.MaterialCopy.AccountNumber</td>
                    <td>@issue.IssueDate</td>
                    <td>@issue.DueDate</td>
                    <td style="color: @statusColor; font-weight:bold;">
                        @issue.Status
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>



