@model IEnumerable<LibraryMangement.Models.Circulation>

@{
    Layout = "~/Views/Shared/_PatronLayout.cshtml";
    ViewBag.Title = "My Booking List";
}

<h2 class="text-center my-4">My Booking List</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model != null && Model.Any())
{
    <table class="table table-bordered table-hover">
        <thead class="table-primary text-uppercase small">
            <tr>
                <th>Material Title</th>
                <th>Booking Date</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.Material.Title</td>
                    <td>@booking.RequestedDate</td>
                    <td>@booking.ExpiryDate</td>
                    <td>@booking.Status</td>
                    <td>
                        @if (booking.Status == "Requested")
                        {
                            <form method="post" action="@Url.Action("CancelReservation", "Patron")" style="display:inline;">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="circulationId" value="@booking.CirculationID" />

                                <button type="submit" class="btn btn-sm btn-danger">Remove</button>
                            </form>


                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-center text-muted">Your booking list is empty.</p>
}
