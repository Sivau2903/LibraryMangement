@model IEnumerable<LibraryMangement.Models.MaterialViewModel>

@{
    Layout = "~/Views/Shared/_PatronLayout.cshtml";
    ViewBag.Title = "Manage Materials";
    var cart = ViewBag.CartMaterialIDs as List<int> ?? new List<int>();
}



<div class="card shadow-sm border-0">
    <div class="card-body">
        <table id="Materials" class="table table-hover table-striped display" style="width:100%">
            <thead class="table-primary text-uppercase small">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Edition</th>
                    <th>Description</th>
                    <th>Publishers</th>
                    <th>Year</th>
                    <th>Pages</th>
                    <th>Volume</th>
                    
                    <th>Available Qty</th>
                   
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var material in Model)
                {
                    bool inCart = cart.Contains(material.MaterialID);

                <tr>
                    <td>@material.Title</td>
                    <td>@material.Author</td>
                    <td>@material.Edition</td>
                    <td>@material.Description</td>
                    <td>@material.PlaceofPublishers</td>
                    <td>@material.YearPublished</td>
                    <td>@material.Pages</td>
                    <td>@material.Vol</td>

                    <td>@material.AvailableQuantity</td>


                    <td>
                        @if (material.AvailableQuantity > 0 && !cart.Contains(material.MaterialID))
                        {
                            <a class="btn btn-sm btn-primary" href="@Url.Action("AddToCart", new { id = material.MaterialID })">Add to Cart</a>
                        }
                        else if (cart.Contains(material.MaterialID))
                        {
                            <button class="btn btn-sm btn-secondary" disabled>Already in Cart</button>
                        }
                        else
                        {
                            <button class="btn btn-sm btn-danger" disabled>No Stock</button>
                        }
                    </td>
                </tr>
                }
            </tbody>
        </table>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            $('#Materials').DataTable({
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                columnDefs: [
                    { orderable: false, targets: 9 } // Disable sorting for Actions column
                ]
            });
        });
    </script>
}
