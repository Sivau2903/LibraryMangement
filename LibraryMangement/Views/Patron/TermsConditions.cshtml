@{
    Layout = "~/Views/Shared/_PatronLayout.cshtml";
    ViewBag.Title = "Library Rules & Conditions";
  
}

<!-- Include Bootstrap (if not already included) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
<style>
    .my-5 {
        margin-top: 1rem !important;
        margin-bottom: 1rem !important;
    }
</style>
<div class="container my-5">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-info text-dark text-center rounded-top-4 py-4">
            <h2 class="fw-bold mb-0">
                <i class="bi bi-book"></i> Library Rules & Conditions
            </h2>
            <p class="text-muted mb-0">The ICFAI University Library</p>
        </div>

        <div class="card-body bg-light p-4">
            <!-- Library Card Conditions -->
            <div class="mb-5">
                <h4 class="text-justify fw-semibold mb-3">
                    <i class="bi bi-card-list"></i> Library Card Conditions
                </h4>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item bg-light">
                        This card enables the holder to borrow books and he/she will be responsible for the books drawn on this card.
                    </li>
                    <li class="list-group-item bg-light">
                        Books must be returned within a period not exceeding 15 days.
                    </li>
                    <li class="list-group-item bg-light">
                        Lost, defaced, or mutilated books must be replaced by the borrower or the cost paid as per rule.
                    </li>
                    <li class="list-group-item bg-light">
                        A fine of ₹5 per day per book will be charged if a book is not returned on the due date.
                    </li>
                    <li class="list-group-item bg-light">
                        The student will be responsible for misuse of this card.
                    </li>
                    <li class="list-group-item bg-light">
                        The librarian may recall a book at any time in case of urgency.
                    </li>
                    <li class="list-group-item bg-light">
                        The library card must be returned before taking “No Dues”.
                    </li>
                    <li class="list-group-item bg-light">
                        Students must read the Library Rules carefully and promise to abide by them.
                    </li>
                </ul>
            </div>

            <!-- General Rules and Regulations -->
            <div>
                <h4 class="text-justify fw-semibold mb-3">
                    <i class="bi bi-info-circle"></i> General Rules & Regulations
                </h4>
                <ul class="list-group list-group-numbered list-group-flush">
                    <li class="list-group-item bg-light">Users should be polite to the librarian, staff, and fellow students.</li>
                    <li class="list-group-item bg-light">Only users with a valid registered library card will be allowed entry.</li>
                    <li class="list-group-item bg-light">Visitors are allowed only with prior permission and introduction letter from their institution.</li>
                    <li class="list-group-item bg-light">Personal belongings must be left at the counter; only loose papers and notebooks are allowed inside.</li>
                    <li class="list-group-item bg-light">Users must keep mobile phones switched off or in silent mode.</li>
                    <li class="list-group-item bg-light">Maintain silence at all times; do not disturb others.</li>
                    <li class="list-group-item bg-light">Defacement, damage, or marking of library materials is punishable.</li>
                    <li class="list-group-item bg-light">Smoking, eating, chewing gum, or gossiping is strictly prohibited.</li>
                    <li class="list-group-item bg-light">Students causing disturbance may be denied entry to the library.</li>
                    <li class="list-group-item bg-light">Users leaving the library must allow staff to check their belongings if required.</li>
                </ul>
            </div>
        </div>

        <div class="card-footer text-center bg-white border-0 py-3">
            <p class="text-muted mb-0">
                <small>© ICFAI University Library – Committed to Learning and Discipline</small>
            </p>
        </div>
    </div>
</div>

<!-- Bootstrap Icons (Optional but recommended) -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet">