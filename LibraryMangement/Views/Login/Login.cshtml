@model LibraryMangement.Models.LoginViewModel
@{
    Layout = null;
    ViewBag.Title = "Login";
}

<!-- Load Bootstrap Icons and Google Fonts -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600;700&display=swap" rel="stylesheet" />

<div class="login-wrapper">
    <div class="login-card animate__animated animate__fadeIn">
        <div class="logo">
            @*<i class="bi bi-book-fill"></i>*@
            <h2>Library Management System</h2>
        </div>

        @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { id = "loginForm", @class = "form-container" }))
        {
            <!-- Username -->
            <div class="form-group">
                <label for="Username"><i class="bi bi-person-fill"></i> Username</label>
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Enter your email", required = "required" })
                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
            </div>

            <!-- Password -->
            <div class="form-group">
                <label for="Password"><i class="bi bi-lock-fill"></i> Password</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password", required = "required" })
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <!-- Captcha -->
            <div class="form-group mb-3">
                <label><i class="bi bi-shield-check"></i> Enter Captcha</label>
                <div class="captcha-box">
                    @Html.TextBoxFor(m => m.CaptchaCode, new { @class = "form-control captcha-input", placeholder = "Enter captcha", required = "required" })
                    <img id="captchaImage" src="@Url.Action("GenerateCaptcha", "Login")" alt="Captcha" class="captcha-img" />
                    <button type="button" class="refresh-btn" id="refreshCaptcha" title="Refresh Captcha">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
                @Html.ValidationMessageFor(m => m.CaptchaCode, "", new { @class = "text-danger" })
            </div>

            <!-- Error Message -->
            if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger animate__animated animate__shakeX">
                    @ViewBag.ErrorMessage
                </div>
            }

            <!-- Login Button -->
            <button type="submit" class="btn btn-login w-100">
                <i class="bi bi-box-arrow-in-right"></i> Login
            </button>

            <!-- Forgot Password Link -->
            <div class="forgot-password">
                <a href="@Url.Action("ForgotPassword", "Login")">Forgot Password?</a>
            </div>
        }
    </div>
</div>

<style>
    /* Global styles */
    * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: 'Poppins', sans-serif;
    }

    /* Wrapper */
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background-image: url('/Images/Login.jpg');
        background-repeat: no-repeat;
        background-position: center center;
        background-size: cover;
        position: relative;
        overflow: hidden;
    }

        /* Overlay for better contrast */
        .login-wrapper::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.45);
            z-index: 1;
        }

    /* Card */
    .login-card {
        background: rgba(255, 255, 255, 0.85);
        padding: 35px 30px;
        border-radius: 20px;
        box-shadow: 0 10px 35px rgba(0, 0, 0, 0.25);
        max-width: 420px;
        width: 100%;
        text-align: center;
        position: relative;
        z-index: 2;
        backdrop-filter: blur(12px);
        transition: all 0.3s ease;
    }

/*        .login-card:hover {
            background: rgba(255, 255, 255, 0.95);
            transform: scale(1.02);
            box-shadow: 0 12px 45px rgba(0, 0, 0, 0.3);
        }*/

    /* Logo */
    .logo {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-bottom: 0px;
    }

        .logo i {
            font-size: 2rem;
            color: #1E40AF;
            margin-top: -44px;
            margin-left: -43px;
        }

    .login-card h2 {
        color: #1E40AF;
        font-weight: 700;
        font-size: 1.8rem;
        text-transform: uppercase;
        letter-spacing: 1.5px;
    }

    /* Form groups */
    .form-group {
        margin-bottom: 20px;
        text-align: left;
        position: relative;
    }

        .form-group label {
            font-weight: 500;
            color: #1E40AF;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 10px;
            font-size: 0.95rem;
        }

    /* Input fields */
    .form-control {
        width: 100%;
        padding: 12px 15px 12px 40px;
        border-radius: 12px;
        border: 1px solid #BFDBFE;
        font-size: 1rem;
        background: rgba(255, 255, 255, 0.9);
        transition: all 0.3s ease;
    }

        .form-control:focus {
            border-color: #1E40AF;
            box-shadow: 0 0 8px rgba(30, 64, 175, 0.3);
            outline: none;
            background: #fff;
        }

    /* Captcha container */
    .captcha-box {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }

    .captcha-img {
        height: 45px;
        border: 2px solid #1E40AF;
        border-radius: 10px;
        background: #fff;
        transition: transform 0.3s ease;
    }

        .captcha-img:hover {
            transform: scale(1.05);
        }

    .refresh-btn {
        background: #1E40AF;
        border: none;
        color: #fff;
        font-size: 1.2rem;
        padding: 8px;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
    }

        .refresh-btn:hover {
            background: #2563EB;
            transform: rotate(360deg);
        }

    /* Login button */
    .btn-login {
        background: linear-gradient(90deg, #1E40AF, #60A5FA);
        color: white;
        font-weight: 600;
        padding: 12px;
        border: none;
        border-radius: 12px;
        font-size: 1rem;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        transition: all 0.3s ease;
    }

        .btn-login:hover {
            background: linear-gradient(90deg, #2563EB, #93C5FD);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.25);
        }

    /* Forgot Password */
    .forgot-password {
        margin-top: 15px;
        text-align: center;
    }

        .forgot-password a {
            color: #1E40AF;
            text-decoration: none;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.3s ease;
        }

            .forgot-password a:hover {
                color: #2563EB;
                text-decoration: underline;
            }

    /* Error message */
    .alert-danger {
        font-size: 0.9rem;
        padding: 10px;
        border-radius: 10px;
        margin-bottom: 20px;
        background: #FEE2E2;
        color: #B91C1C;
        border: 1px solid #FCA5A5;
    }

    /* Responsive design */
    @@media (max-width: 768px) {
        .login-card {
            max-width: 90%;
            padding: 30px 20px;
        }

            .login-card h2 {
                font-size: 1.5rem;
            }

        .login-wrapper::before {
            background: rgba(0, 0, 0, 0.5);
        }
    }

    @@media (max-width: 480px) {
        .login-card {
            padding: 25px 15px;
        }

        .captcha-box {
            flex-direction: column;
            align-items: flex-start;
        }

        .captcha-img {
            width: 100%;
            height: auto;
        }

        .login-card h2 {
            font-size: 1.4rem;
        }
    }
</style>


<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>
<!-- Animate.css for animations -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" rel="stylesheet" />

<script>
    // Refresh captcha function
    function refreshCaptcha() {
        $('#captchaImage').attr('src', '@Url.Action("GenerateCaptcha", "Login")?t=' + new Date().getTime());
    }

    // Manual refresh
    $('#refreshCaptcha').on('click', function () {
        refreshCaptcha();
        $(this).addClass('animate__animated animate__rotateIn');
        setTimeout(() => $(this).removeClass('animate__animated animate__rotateIn'), 1000);
    });

    // Auto refresh every 60 seconds
    setInterval(refreshCaptcha, 60000);

    // Hash password client-side before submit
    $('#loginForm').submit(function (e) {
        const passwordInput = $('input[name="Password"]');
        if (passwordInput.val()) {
            const hashedHex = CryptoJS.SHA256(passwordInput.val()).toString(CryptoJS.enc.Hex);
            passwordInput.val(hashedHex);
        }
    });

    // Input field animations
    $('.form-control').on('focus', function () {
        $(this).parent().find('label').addClass('animate__animated animate__pulse');
    }).on('blur', function () {
        $(this).parent().find('label').removeClass('animate__animated animate__pulse');
    });

    //// Card hover fade effect
    //$('.login-card').on('mouseenter', function () {
    //    $(this).removeClass('animate__fadeIn').addClass('animate__animated animate__pulse');
    //}).on('mouseleave', function () {
    //    $(this).removeClass('animate__animated animate__pulse');
    //});
</script>