@model LibraryMangement.Models.LoginViewModel
@{
    Layout = null;
    ViewBag.Title = "Login";
}

<div class="login-wrapper">
    <div class="login-card">

        <h2>Login</h2>

        @using (Html.BeginForm("Login", "Login", FormMethod.Post, new { id = "loginForm" }))
        {
            <!-- Username -->
            <div class="form-group">
                <label>Username</label>
                @Html.TextBoxFor(m => m.Username, new { @class = "form-control", placeholder = "Enter your email" })
            </div>

            <!-- Password -->
            <div class="form-group">
                <label>Password</label>
                @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password" })
            </div>

            <!-- Captcha -->
            <div class="form-group">
                <label>Enter Captcha</label>
                <div class="d-flex align-items-center gap-2">
                    @Html.TextBoxFor(m => m.CaptchaCode, new { @class = "form-control", placeholder = "Enter captcha" })
                    <img src="@Url.Action("GenerateCaptcha", "Login")" alt="Captcha" class="captcha-img" />
                </div>
            </div>

            <!-- Error Message -->
            if (ViewBag.ErrorMessage != null)
            {
                <div class="alert alert-danger text-center">@ViewBag.ErrorMessage</div>
            }

            <!-- Login Button -->
            <button type="submit" class="btn btn-login w-100">Login</button>
        }
    </div>
</div>

<style>
    /* Wrapper */
    .login-wrapper {
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: linear-gradient(135deg, #1E3A8A, #EF4444);
        padding: 15px;
    }

    /* Card */
    .login-card {
        background: #fff;
        padding: 45px 35px;
        border-radius: 15px;
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.2);
        max-width: 420px;
        width: 100%;
        text-align: center;
        position: relative;
    }

    /* Logo */
    .icfai-logo {
        display: block;
        margin: 0 auto 25px;
        max-width: 120px;
    }

    /* Title */
    .login-card h2 {
        color: #1E3A8A;
        font-weight: 700;
        margin-bottom: 30px;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    /* Form groups */
    .form-group {
        margin-bottom: 20px;
        text-align: left;
    }

        .form-group label {
            font-weight: 600;
            color: #37474f;
            display: block;
            margin-bottom: 8px;
        }

    /* Input fields */
    .form-control {
        width: 100%;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #ccc;
        font-size: 15px;
        transition: border-color 0.3s ease, box-shadow 0.3s ease;
    }

        .form-control:focus {
            border-color: #1E3A8A;
            box-shadow: 0 0 5px rgba(30, 58, 138, 0.3);
            outline: none;
        }

    /* Captcha image */
    .captcha-img {
        height: 45px;
        border: 2px solid #d32f2f;
        border-radius: 8px;
    }

    /* Login button */
    .btn-login {
        background: linear-gradient(90deg, #1E3A8A, #EF4444);
        color: white;
        font-weight: 600;
        padding: 12px;
        border: none;
        border-radius: 8px;
        font-size: 16px;
        cursor: pointer;
        transition: background 0.3s ease, transform 0.2s ease;
    }

        .btn-login:hover {
            background: linear-gradient(90deg, #145ca0, #dc2626);
            transform: translateY(-2px);
        }
</style>
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/crypto-js/4.1.1/crypto-js.min.js"></script>


<script>
    function refreshCaptcha() {
        $('#captchaImage').attr('src', '@Url.Action("CaptchaImage","Account")?t=' + new Date().getTime());
    }

    // Hash password client-side before submit
    $('#loginForm').submit(function () {
        const passwordInput = $('input[name="Password"]');
        if (passwordInput.val()) {
            // Convert password → SHA256 → hex
            const hashedHex = CryptoJS.SHA256(passwordInput.val()).toString(CryptoJS.enc.Hex);
            passwordInput.val(hashedHex);
        }
    });


    // Toastr notifications
    @if (TempData["Error"] != null)
    {
        <text>toastr.error("@TempData["Error"]");</text>
    }
    @if (TempData["Success"] != null)
    {
        <text>toastr.success("@TempData["Success"]");</text>
    }
</script>
