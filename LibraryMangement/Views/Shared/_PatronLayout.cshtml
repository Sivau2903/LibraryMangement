<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Patron Dashboard</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar */
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: #1f2937;
            color: white;
            min-height: 86vh;
            box-shadow: 2px 0 5px rgba(0,0,0,0.2);
            transition: all 0.3s;
        }

        .sidebar h5 {
            border-bottom: 1px solid #495057;
            padding-bottom: 0.5rem;
        }

        .sidebar a {
            color: white;
            text-decoration: none;
            padding: 10px 15px;
            border-radius: 5px;
            display: flex;
            align-items: center;
            transition: all 0.2s ease-in-out;
        }

        .sidebar a:hover {
            background-color: white;
            color: #1f2937;
            padding-left: 20px;
        }

        .sidebar i {
            margin-right: 10px;
        }

        .content {
            flex: 1;
            padding: 10px;
            background-color: #f8f9fa;
        }

        footer {
            background-color: darkgrey;
            color: white;
            text-align: center;
            padding: 10px 1px;
            font-size: 0.9rem;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.2);
        }

        .rotate {
            transform: rotate(180deg);
            transition: transform 0.3s;
        }

        /* Mobile Responsive */
        @@media (max-width: 992px) {
            #sidebar {
                position: fixed;
                top: 0;
                left: -250px;
                width: 250px;
                height: 100%;
                z-index: 1050;
                transition: left 0.3s ease-in-out;
            }

            #sidebar.show {
                left: 0;
            }

            .content {
                padding: 10px;
            }
        }

        /* Logout popup */
        .logout-popup {
            position: fixed;
            top: 40px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 2000;
            width: 400px;
            display: none;
            text-align: center;
        }
    </style>
</head>
<body>

    <!-- Navbar -->
    @{
        // 🧠 Get the Role from Session
        string userRole = Session["Role"] != null ? Session["Role"].ToString() : "";

        // 🏷️ Decide dashboard label and target action based on role
        string dashboardLabel = "ICFAI User";
        string dashboardAction = "PatronDashboard"; // default

        if (userRole.Equals("Student", StringComparison.OrdinalIgnoreCase))
        {
            dashboardLabel = "Student Dashboard";
            dashboardAction = "PatronDashboard";  // make sure you have this action
        }
        else if (userRole.Equals("Faculty", StringComparison.OrdinalIgnoreCase))
        {
            dashboardLabel = "Faculty Dashboard";
            dashboardAction = "PatronDashboard"; 
        }
    }

    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
        <div class="container-fluid">
            <button class="btn btn-outline-light d-lg-none me-3" type="button" id="sidebarToggle">
                <i class="bi bi-list"></i>
            </button>

            <!-- 🏠 Dynamic Dashboard Link -->
            <a class="navbar-brand fw-bold fs-4" href="@Url.Action(dashboardAction, "Patron")">@dashboardLabel</a>

            <div class="d-flex align-items-center ms-auto">
                @if (ViewBag.Breadcrumbs != null)
                {
                    <div class="me-2">
                        @Html.Partial("_Breadcrumb", (List<LibraryMangement.Models.BreadcrumbItem>)ViewBag.Breadcrumbs)
                    </div>
                }

                <ul class="navbar-nav align-items-center ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link fw-bold fs-4 dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button" data-bs-toggle="dropdown">
                            My Profile
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="profileDropdown" style="min-width: 200px;">
                            <li><a class="dropdown-item" href="@Url.Action("MyProfile", "Patron")"><i class="bi bi-person-circle me-2"></i> View Profile</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("ChangePassword", "Patron")"><i class="bi bi-key me-2"></i> Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="#" id="logoutLink"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="d-flex">
        <!-- Sidebar -->
        <div class="sidebar p-3" id="sidebar">
            <h5 class="mb-4" style="color:white">Menu</h5>
            <ul class="nav flex-column">
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("PatronDashboard", "Patron")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("ManageMaterials", "Patron")"><i class="bi bi-book"></i> Borrow Library Resource</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("MyReservations", "Patron")"><i class="bi bi-files"></i> My Reservations</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("MyBookingList", "Patron")"><i class="bi bi-files"></i> My Booking List</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("IssuedHistory", "Patron")"><i class="bi bi-box-arrow-in-right"></i> Borrowed History</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("OverdueList", "Patron")"><i class="bi bi-files"></i> Overdue List</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("TermsConditions", "Patron")"><i class="bi bi-files"></i> Terms & Conditions</a></li>
            </ul>
        </div>

        <!-- Content -->
        <div class="content container-fluid">
            @RenderBody()
        </div>
    </div>

    <footer>
        &copy; 2025 ICFAI Library Management System | Developed by Shiva
    </footer>


    <!-- jQuery first -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>



    <script>
        $(document).ready(function () {
            // Sidebar toggle for mobile
            $("#sidebarToggle").click(function () {
                $("#sidebar").toggleClass("show");
            });

            // Sidebar dropdown toggle
            $('.sidebar a[data-bs-toggle="collapse"]').on('click', function (e) {
                var target = $($(this).attr('href'));
                target.collapse('toggle');
                $('.sidebar .collapse').not(target).collapse('hide'); // close others
                $(this).find('i.bi-chevron-down').toggleClass('rotate');
            });

            // Close dropdown if clicked outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('.sidebar, #sidebarToggle').length) {
                    $('.sidebar .collapse').collapse('hide');
                    $('.sidebar a[data-bs-toggle="collapse"] i.bi-chevron-down').removeClass('rotate');
                    if ($("#sidebar").hasClass("show")) {
                        $("#sidebar").removeClass("show");
                    }
                }
            });

            // Logout popup
            $("#logoutLink").on("click", function (e) {
                e.preventDefault();
                $("#logoutPopup").fadeIn(300);
            });
            $("#cancelLogout").on("click", function () {
                $("#logoutPopup").fadeOut(200);
            });
        });
    </script>

    <!-- Logout popup -->
    <div id="logoutPopup" class="logout-popup shadow-sm bg-light border p-3 rounded">
        <h6 class="mb-3 text-center fw-bold">Confirm Logout</h6>
        <p class="text-center mb-3">Are you sure you want to logout?</p>
        <div class="d-flex justify-content-center gap-2">
            <button id="cancelLogout" class="btn btn-outline-secondary btn-sm">Cancel</button>
            <a id="confirmLogout" href="@Url.Action("Logout", "Login")" class="btn btn-primary btn-sm">Logout</a>
        </div>
    </div>
    @RenderSection("Scripts", required: false)

</body>
</html>
