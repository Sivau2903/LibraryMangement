<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Patron Dashboard</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">

    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .modal-dialog {
            position: absolute;
            top: 10%;
            left: 50%;
            transform: translateX(-50%);
        }


        /* Sidebar */
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: #1f2937; /* Darker shade for modern look */
            color: white;
            min-height: 86vh;
            box-shadow: 2px 0 5px rgba(0,0,0,0.2);
        }

            .sidebar h5 {
                border-bottom: 1px solid #495057;
                padding-bottom: 0.5rem;
            }

            .sidebar a {
                color: white;
                text-decoration: none;
                padding: 10px 15px;
                border-radius: 5px;
                display: flex;
                align-items: center;
                transition: all 0.2s ease-in-out;
            }

                .sidebar a:hover {
                    background-color: white;
                    text-decoration: none;
                    padding-left: 20px;
                }

            .sidebar i {
                margin-right: 10px;
            }

        /* Content */
        .content {
            flex: 1;
            padding: 5px;
            background-color: #f8f9fa;
        }
        .logout-popup {
            position: fixed;
            top: 40px; /* Distance from top */
            left: 50%;
            transform: translateX(-50%);
            z-index: 2000;
            width: 400px;
            display: none; /* Hidden by default */
            text-align: center;
        }

        /* Footer */
        footer {
            background-color: darkgrey;
            color: white;
            text-align: center;
            padding: 10px 1px;
            font-size: 0.9rem;
            position: page;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.2);
        }

        /* Navbar Brand */
        .navbar-brand {
            font-weight: bold;
        }

        .navbar {
            --bs-navbar-padding-x: 1rem;
            --bs-navbar-padding-y: 0.8rem;
        }
    </style>
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-4" href="@Url.Action("PatronDashboard", "Patron")">
                ICFAI User
            </a>
            <!-- Breadcrumbs + Profile wrapped in one flex container -->
            <div class="d-flex align-items-center">

                <!-- Breadcrumbs -->
                @if (ViewBag.Breadcrumbs != null)
                {
                    <div class="me-2">
                        @Html.Partial("_Breadcrumb", (List<LibraryMangement.Models.BreadcrumbItem>)ViewBag.Breadcrumbs)
                    </div>
                }

                <!-- Profile Dropdown -->
                <ul class="navbar-nav align-items-center ms-3">
                    <li class="nav-item dropdown">
                        <a class="nav-link fw-bold fs-4 dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            My Profile
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="profileDropdown" style="min-width: 200px;">
                            <li><a class="dropdown-item d-flex align-items-center" href="@Url.Action("MyProfile", "Patron")"><i class="bi bi-person-circle me-2"></i> View Profile</a></li>
                            <li><a class="dropdown-item d-flex align-items-center" href="@Url.Action("ChangePassword", "Patron")"><i class="bi bi-key me-2"></i> Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <a class="dropdown-item d-flex align-items-center text-danger" href="#" id="logoutLink">
                                    <i class="bi bi-box-arrow-right me-2"></i> Logout
                                </a>
                            </li>
                        </ul>
                    </li>
                </ul>

            </div>
        </div>
    </nav>

    <div class="d-flex">
        <!-- Sidebar Menu -->
        <div class="sidebar p-3">
            <h5 class="mb-4" style="color:white">Menu</h5>
            <ul class="nav flex-column">
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("PatronDashboard", "Patron")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("ManageMaterials", "Patron")"><i class="bi bi-book"></i> Borrow Libarary Resource</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("MyReservations", "Patron")"><i class="bi bi-files"></i> My Reservations </a></li>

                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("MyBookingList", "Patron")"><i class="bi bi-files"></i> My Booking List </a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("IssuedHistory", "Patron")"><i class="bi bi-box-arrow-in-right"></i> Borrowed History</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("OverdueList", "Patron")"><i class="bi bi-files"></i> OverDue List </a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("TermsConditions", "Patron")"><i class="bi bi-files"></i> Terms & Conditions </a></li>

            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="content container-fluid">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer>
        &copy; 2025 ICFAI Library Management System | Developed by Shiva
    </footer>

    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            // Show popup on logout click
            $("#logoutLink").on("click", function (e) {
                e.preventDefault();
                $("#logoutPopup").fadeIn(300);
            });

            // Cancel button hides popup
            $("#cancelLogout").on("click", function () {
                $("#logoutPopup").fadeOut(200);
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
    <!-- Logout Confirmation Modal -->
<div id="logoutPopup" class="logout-popup shadow-sm bg-light border p-3 rounded" style="display:none;">
    <h6 class="mb-3 text-center fw-bold">Confirm Logout</h6>
    <p class="text-center mb-3">Are you sure you want to logout?</p>
    <div class="d-flex justify-content-center gap-2">
        <button id="cancelLogout" class="btn btn-outline-secondary btn-sm">Cancel</button>
        <a id="confirmLogout" href="@Url.Action("Logout", "Login")" class="btn btn-primary btn-sm">Logout</a>
    </div>
</div>

</body>
</html>
