<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Librarian Dashboard</title>

    <!-- Bootstrap CSS -->
   

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.4/css/jquery.dataTables.min.css">
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>



    <style>
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Sidebar */
        .sidebar {
            min-width: 250px;
            max-width: 250px;
            background-color: #1f2937; /* Darker shade for modern look */
            color: white;
            min-height: 86vh;
            box-shadow: 2px 0 5px rgba(0,0,0,0.2);
        }

            .sidebar h5 {
                border-bottom: 1px solid #495057;
                padding-bottom: 0.5rem;
                padding-top: 30px;
            }

            .sidebar a {
                color: white;
                text-decoration: none;
                padding: 10px 15px;
                border-radius: 5px;
                display: flex;
                align-items: center;
                transition: all 0.2s ease-in-out;
            }

                .sidebar a:hover {
                    background-color: white;
                    text-decoration: none;
                    padding-left: 20px;
                }

            .sidebar i {
                margin-right: 10px;
            }

        /* Content */
        .content {
            flex: 1;
            padding: 20px;
            background-color: #f8f9fa;
        }

        /* Footer */
        footer {
            background-color: darkgrey;
            color: white;
            text-align: center;
            padding: 10px 1px;
            font-size: 0.9rem;
            position: page;
            box-shadow: 0 -2px 5px rgba(0,0,0,0.2);
        }

        /* Navbar Brand */
        .navbar-brand {
            font-weight: bold;
        }

        .navbar {
            --bs-navbar-padding-x: 1rem;
            --bs-navbar-padding-y: 0.8rem;
        }
    </style>
</head>
<body>

    <!-- Top Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark" style="background: linear-gradient(90deg, #0d6efd, #6610f2);">
        <div class="container-fluid">
            <a class="navbar-brand fw-bold fs-4" href="@Url.Action("LibrarianDashboard", "Librarian")">
                ICFAI Library Admin
            </a>
            <div class="collapse navbar-collapse justify-content-end">
                <ul class="navbar-nav align-items-center">
                    <!-- Profile Dropdown -->
                    <li class="nav-item dropdown">
                        <a class="nav-link fw-bold fs-4 dropdown-toggle d-flex align-items-center" href="#" id="profileDropdown" role="button"
                           data-bs-toggle="dropdown" aria-expanded="false">
                            My Profile
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg" aria-labelledby="profileDropdown" style="min-width: 200px;">
                            <li><a class="dropdown-item d-flex align-items-center" href="@Url.Action("MyProfile", "Librarian")"><i class="bi bi-person-circle me-2"></i> View Profile</a></li>
                            <li><a class="dropdown-item d-flex align-items-center" href="@Url.Action("ChangePassword", "Librarian")"><i class="bi bi-key me-2"></i> Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item d-flex align-items-center text-danger" href="@Url.Action("Logout", "Login")"><i class="bi bi-box-arrow-right me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="d-flex">
        <!-- Sidebar Menu -->
        <div class="sidebar" id="sidebar">
            <h5 class="mb-4" style="color:white">Menu</h5>
            <ul class="nav flex-column">

                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("LibrarianDashboard", "Librarian")"><i class="bi bi-speedometer2"></i> Dashboard</a></li>

                <!-- Circulations Dropdown (Flattened) -->
                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#circulationMenu" role="button" aria-expanded="false" aria-controls="circulationMenu">
                        <span><i class="bi bi-arrow-repeat"></i> Circulations</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ps-3" id="circulationMenu">
                        <ul class="nav flex-column">
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("IssueMaterial", "Librarian")">Issue Material</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("ReturnMaterial", "Librarian")">Return Material</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("ReturnMaterial", "Librarian")">Renew Material</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("BookingList", "Librarian")">Holds & Book Lists</a></li>
                            @*<li class="nav-item"><a class="nav-link" href="@Url.Action("OverdueReports", "Librarian")">Issue Report</a></li>*@

                        </ul>
                    </div>
                </li>

                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#manageMaterials" role="button" aria-expanded="false" aria-controls="manageMaterials">
                        <span><i class="bi bi-arrow-repeat"></i> Manage Materials</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ps-3" id="manageMaterials">
                        <ul class="nav flex-column">
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("ManageMaterials", "Librarian")">Manage Materials</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("ManageMaterialCopies", "Librarian")">Manage Material Copies</a></li>

                        </ul>
                    </div>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link d-flex justify-content-between align-items-center" data-bs-toggle="collapse" href="#reportmenue" role="button" aria-expanded="false" aria-controls="reportmenue">
                        <span><i class="bi bi-arrow-repeat"></i> Reports</span>
                        <i class="bi bi-chevron-down"></i>
                    </a>
                    <div class="collapse ps-3" id="reportmenue">
                        <ul class="nav flex-column">
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("OverdueReports", "Librarian")">Overdue Report</a></li>
                            <li class="nav-item"><a class="nav-link" href="@Url.Action("FineReport", "Librarian")">Fine Report</a></li>

                        </ul>
                    </div>
                </li>

                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("AddAuthor", "Librarian")"><i class="bi bi-book"></i> Add Author</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("AddMaterialType", "Librarian")"><i class="bi bi-files"></i> Add Material Type</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("AddFineReason", "Librarian")"><i class="bi bi-book"></i> Add Fine Reason</a></li>
                <li class="nav-item mb-2"><a class="nav-link" href="@Url.Action("BarcodeGeneration", "Librarian")"><i class="bi bi-upc-scan"></i> Barcode Generation</a></li>

            </ul>
        </div>

        <!-- Main Content Area -->
        <div class="content container-fluid">
            @RenderBody()
        </div>
    </div>

    <!-- Footer -->
    <footer>
        &copy; 2025 ICFAI Library Management System | Developed by Shiva
    </footer>


    <!-- Scripts -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.4/js/jquery.dataTables.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
