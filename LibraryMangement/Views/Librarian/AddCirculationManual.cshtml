@model LibraryMangement.Models.CirculationViewModel

<div class="container mt-5">
    <div class="card shadow-lg p-4 rounded-4">
        <h4 class="text-center text-primary mb-4 fw-bold">Manual Circulation Entry</h4>

        <form id="manualCirculationForm">
            <div class="row g-4 mb-4">

                <!-- USER TYPE -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">User Type</label>
                    <select id="UserType" class="form-select shadow-sm">
                        <option>Student</option>
                        <option>Faculty</option>
                    </select>
                </div>

                <!-- USER IDENTIFIER -->
                <div class="col-md-3">
                    <label id="UserIdentifierLabel" class="form-label fw-semibold">Enrollment Number</label>
                    <input type="text" id="UserIdentifier" class="form-control shadow-sm" required />
                </div>

                <!-- REQUESTED DATE -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Requested Date</label>
                    @Html.TextBoxFor(m => m.RequestedDate, new { @type = "date", @class = "form-control shadow-sm", @id = "RequestedDate" })
                </div>

                <!-- ISSUED DATE -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Issued Date</label>
                    @Html.TextBoxFor(m => m.IssuedDate, new { @type = "date", @class = "form-control shadow-sm", @id = "IssuedDate" })
                </div>
            </div>
            <!-- STATUS -->
            <div class="row mt-4">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Status</label>
                    <select id="Status" class="form-select shadow-sm">
                        <option value="Issued">Issued</option>
                        <option value="Overdue">Overdue</option>
                    </select>
                </div>

                <!-- Overdue Days -->
                <div class="col-md-3" id="overdueSection" style="display:none;">
                    <label class="form-label fw-semibold">Overdue Days</label>
                    <input type="number" id="OverdueDays" name="OverdueDays"
                           class="form-control shadow-sm" min="1" />
                </div>

            </div>

            <!-- TITLE SEARCH -->
            <div class="row mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Title</label>
                    <input type="text" id="Title" placeholder="Search Title"
                           class="form-control shadow-sm" autocomplete="off" />
                </div>
            </div>

            <!-- TABLE -->
            <table id="materialsTable" class="table table-bordered table-striped" style="display:none;">
                <thead class="table-dark">
                    <tr>
                        <th>Material ID</th>
                        <th>Title</th>
                        <th>Author</th>
                        <th>Year</th>
                        <th>Edition</th>
                        <th>Available Barcode</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>

            <!-- HIDDEN FIELDS -->
            <input type="hidden" id="MaterialID" />
            <input type="hidden" id="SelectedBarcode" />



            @*<div class="text-center mt-4">
            <button type="button" id="SaveIssue" class="btn btn-success btn-lg px-4">Save</button>
        </div>*@
        </form>
    </div>
</div>


@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
$(document).ready(function () {

    // Change label for student/faculty
    $('#UserType').change(function () {
        $('#UserIdentifierLabel').text($(this).val() === "Student" ? "Enrollment Number" : "Employee ID");
    });

    // Show overdue days only when overdue selected
    $('#Status').change(function () {
        if ($(this).val() === "Overdue") {
            $('#overdueSection').show();
        } else {
            $('#overdueSection').hide();
            $('#OverdueDays').val('');
        }
    });

    // Autocomplete for title
    $('#Title').autocomplete({
        source: function (req, res) {
            $.get('@Url.Action("GetMaterialTitles","Librarian")', { term: req.term }, function (data) {
                res($.map(data, function (i) { return { label: i.Title, value: i.Title }; }));
            });
        },
        select: function (e, ui) {
            loadMaterials(ui.item.value);
        }
    });

  function loadMaterials(title) {

    $.get('@Url.Action("GetMaterialsByTitle","Librarian")', { title: title }, function (data) {

        console.log("Material API Response:", data);

        let tbody = $("#materialsTable tbody");
        tbody.empty();

        if (!data || data.length === 0) {
            $("#materialsTable").hide();
            return;
        }

        $.each(data, function (_, item) {
            tbody.append(`
                <tr>
                    <td>${item.MaterialID}</td>
                    <td>${item.Title}</td>
                    <td>${item.Author}</td>
                    <td>${item.Year}</td>
                    <td>${item.Edition}</td>
                    <td>${item.AvailableBarcode ?? "None"}</td>
                    <td>
                        <button class="btn btn-success btn-sm issue-now"
                                data-id="${item.MaterialID}"
                                data-bc="${item.AvailableBarcode}">
                            Mark as Issued
                        </button>
                    </td>
                </tr>
            `);
        });

        $("#materialsTable").show();
    });
}



    // Select material
  $(document).on("click", ".issue-now", function () {

    $("#OverdueDays").blur();  // ← IMPORTANT FIX

    let materialID = $(this).data("id");
    let barcode = $(this).data("bc");

    if (!barcode) {
        alert("No available barcode for this material!");
        return;
    }

    let overdueValue = 0;

    if ($("#Status").val() === "Overdue") {
        let enteredValue = $("#OverdueDays").val();

        console.log("RAW OverdueDays:", enteredValue);

        overdueValue = parseInt(enteredValue || "0");
    }

    let issueData = {
        UserType: $("#UserType").val(),
        UserIdentifier: $("#UserIdentifier").val(),
        RequestedDate: $("#RequestedDate").val(),
        IssuedDate: $("#IssuedDate").val(),
        MaterialID: materialID,
        Status: $("#Status").val(),
        OverdueDays: overdueValue
    };

    console.log("Sending OverdueDays:", overdueValue);

    $.post('@Url.Action("SaveManualIssue","Librarian")', issueData, function (msg) {
        alert(msg);
        loadMaterials($("#Title").val());
    });
});




    // Save issue
   $("#SaveIssue").click(function () {

    let overdueValue = 0;

    if ($("#Status").val() === "Overdue") {
        overdueValue = parseInt($("#OverdueDays").val() || "0");
    }

    let data = {
        UserType: $("#UserType").val(),
        UserIdentifier: $("#UserIdentifier").val(),
        RequestedDate: $("#RequestedDate").val(),
        IssuedDate: $("#IssuedDate").val(),
        MaterialID: $("#MaterialID").val(),
        Status: $("#Status").val(),
        OverdueDays: overdueValue
    };

    console.log("Sending OverdueDays:", overdueValue); // DEBUG

    $.post('@Url.Action("SaveManualIssue","Librarian")', data, function (msg) {
        alert(msg);
        location.reload();
    });
});

});
    </script>
}
