@model IEnumerable<LibraryMangement.Models.OverdueViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Overdue List";
}

<h2 class="text-center my-4">Overdue Materials</h2>
<div class="row mb-4">
    <div class="col-12 d-flex justify-content-end align-items-center">
        <form method="get" action="@Url.Action("Overduelist", "Librarian")" class="d-flex align-items-center">
            <label for="selectedDays" class="me-2 fw-semibold">Upcoming Overdue (Days):</label>
            <select id="selectedDays" name="selectedDays" class="form-select me-2" required style="width:120px;">
                <option value="">Select</option>
                @for (int i = 1; i <= 5; i++)
                {
                    <option value="@i" @(Request.QueryString["selectedDays"] == i.ToString() ? "selected" : "")>@i</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">Check</button>
        </form>
    </div>
</div>



@if (!Model.Any())
{
    <div class="alert alert-success text-center">
        🎉 No overdue books! All patrons are up to date.
    </div>
}
else
{
    <!-- 🔹 Top Filter Section -->

    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Issue ID</th>
                <th>Material Title</th>
                <th>Patron</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Days Overdue</th>
                <th>Fine</th>
                <th>Status</th>
                <th class="text-center">Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var overdue in Model)
            {
                <tr>
                    <td>@overdue.CirculationID</td>
                    <td>@overdue.MaterialTitle</td>
                    <td>@overdue.PatronName</td>
                    <td>@overdue.IssueDate</td>
                    <td>@overdue.DueDate</td>
                    <td>@overdue.DaysOverdue</td>
                    <td>@overdue.FineAmount.ToString("C")</td>
                    <td>
                        <span class="badge bg-danger">@overdue.Status</span>
                    </td>
                    <td class="text-center">
                        <a href="@Url.Action("ReturnMaterial", "Librarian", new { id = overdue.CirculationID })"
                           class="btn btn-sm btn-danger mb-1">
                            Return/Renew
                        </a>
                        @*<a href="@Url.Action("ReturnMaterial", "Librarian", new { id = overdue.CirculationID })"
                           class="btn btn-sm btn-warning">
                            Renew
                        </a>*@
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
