@model IEnumerable<LibraryMangement.Models.ActiveBookingViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Pending Bookings";
}

<h2 class="text-center my-4">Pending Bookings</h2>

<!-- ✅ Success Message Popup (Top-Center, Small, with Close Button) -->
@if (TempData["SuccessMessage"] != null)
{
    <div id="successPopup" class="alert alert-success alert-dismissible fade show text-center position-fixed top-0 start-50 translate-middle-x mt-3 shadow" style="min-width: 300px; z-index: 2000;">
        <strong>@TempData["SuccessMessage"]</strong>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No pending bookings found.
    </div>
}
else
{
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark">
            <tr>
                <th>Booking ID</th>
                <th>Material Title</th>
                <th>PatronID</th>
                <th>Patron Name</th>
                <th>Booking Date</th>
                <th>Expiry Date</th>
                <th>Status</th>
                <th class="text-center">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.BookingID</td>
                    <td>@booking.MaterialTitle</td>
                    <td>@booking.PatronID</td>
                    <td>@booking.PatronName</td>
                    <td>@booking.BookingDate</td>
                    <td>@booking.ExpiryDate</td>
                    <td>
                        <span class="badge bg-warning text-dark">@booking.Status</span>
                    </td>
                    <td class="text-center">
                        @if (booking.Status == "Pending")
                        {
                            <button type="button" class="btn btn-sm btn-danger" onclick="confirmRemove(@booking.BookingID)">Remove</button>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<!-- ✅ Confirmation Popup -->
<div id="confirmPopup" class="position-fixed top-0 start-50 translate-middle-x mt-3 text-center bg-warning text-dark border rounded shadow p-3"
     style="display:none; min-width: 320px; z-index:2000;">
    <strong>Are you sure you want to remove this booking?</strong>
    <div class="mt-2">
        <button id="confirmYes" class="btn btn-sm btn-success me-2">Yes</button>
        <button id="confirmNo" class="btn btn-sm btn-secondary">No</button>
    </div>
</div>

<!-- ✅ Hidden Form for Removal -->
<form id="removeForm" method="post" action="@Url.Action("RemoveFromBookingList", "Librarian")" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="bookingId" id="bookingId" />
</form>

@section Scripts {
    <script>
        // Show confirmation popup
        function confirmRemove(bookingId) {
            document.getElementById("confirmPopup").style.display = "block";
            document.getElementById("bookingId").value = bookingId;
        }

        // Confirm Yes
        document.getElementById("confirmYes").addEventListener("click", function () {
            document.getElementById("removeForm").submit();
        });

        // Confirm No
        document.getElementById("confirmNo").addEventListener("click", function () {
            document.getElementById("confirmPopup").style.display = "none";
        });

        // Auto-hide success popup
        setTimeout(() => {
            const popup = document.getElementById("successPopup");
            if (popup) popup.style.display = "none";
        }, 3000);
    </script>
}
