@{
    ViewBag.Title = "Walk-in Issue";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (TempData["Success"] != null)
{
    <div class="success-overlay d-flex align-items-center justify-content-center">
        <div class="text-center">
            <i class="bi bi-check-circle-fill display-2 text-success animate-pop"></i>
            <h5 class="mt-2 text-success fw-bold">@TempData["Success"]</h5>
        </div>
    </div>
}

<!-- Error Message -->
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-2">@TempData["Error"]</div>
}
<div class="d-flex justify-content-center mt-3">
    <h3 class="fw-bold text-center">Walk-in Issue</h3>
</div>

<div class="d-flex justify-content-center mt-4">

    <div class="card p-3 mb-3" style="width: 350px;">

        <label class="form-label text-center w-100">Scan / Enter Barcode</label>

        <input type="text" id="scanBarcode" class="form-control text-center fw-semibold"
               placeholder="Scan barcode here..." autofocus />

        <small class="text-muted text-center d-block mt-1">
            Tip: Most scanners press Enter automatically.
        </small>
    </div>
</div>


<div id="scanResult" class="d-none">
    <div class="card p-3">
        <h5 id="bookTitle" class="mb-2"></h5>
        <div class="row">
            <div class="col-md-3"><strong>Total:</strong> <span id="total"></span></div>
            <div class="col-md-3"><strong>Available:</strong> <span id="avail"></span></div>
            <div class="col-md-3"><strong>Requested:</strong> <span id="req"></span></div>
            <div class="col-md-3"><strong>In Circulation:</strong> <span id="circ"></span></div>
            <div class="col-md-12 mt-2"><span id="message" class="fw-semibold"></span></div>
        </div>

        <div class="mt-3">
            <a id="issueBtn" class="btn btn-primary disabled" href="#">Issue This Copy</a>
        </div>
    </div>
</div>

@section Scripts{
    <script>
(function () {
    const $barcode = $('#scanBarcode');
    const $result = $('#scanResult');
    let last = '';

    function fetchInfo(code) {
        $.get('@Url.Action("ScanBarcode","Librarian")', { barcode: code })
         .done(function (res) {
            if (!res || res.Found === false) {
                $result.addClass('d-none');
                alert(res && res.Message ? res.Message : 'Not found');
                return;
            }
             $('#bookTitle').text(res.Title + ' (' + res.BarcodeNumber + ')');
             $('#total').text(res.TotalQuantity);
            $('#avail').text(res.AvailableQuantity);
            $('#req').text(res.RequestedCount);
            $('#circ').text(res.InCirculationCount);
            $('#message').text(res.Message);
            $result.removeClass('d-none');

            const can = !!res.CanIssue;
            const link = '@Url.Action("IssueForm","Librarian")'
                         + '?materialId=' + res.MaterialID
                         + '&copyId=' + res.CopyID
                         + '&barcode=' + encodeURIComponent(res.BarcodeNumber);

            const $btn = $('#issueBtn');
            $btn.attr('href', can ? link : '#')
                .toggleClass('disabled', !can);
         })
         .fail(function () {
            alert('Error checking barcode.');
         });
    }

    // Trigger on Enter (scanners usually append Enter)
    $barcode.on('keydown', function (e) {
        if (e.key === 'Enter') {
            e.preventDefault();
            const code = ($barcode.val() || '').trim();
            if (code && code !== last) {
                last = code;
                fetchInfo(code);
            }
        }
    });
})();
    </script>
}
