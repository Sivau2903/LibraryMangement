@model IEnumerable<LibraryMangement.Models.AvailabilityReportViewModel>

@{
    ViewBag.Title = "Availability Report";
    var titles = (List<string>)ViewBag.Titles;
    var authors = (List<string>)ViewBag.Authors;
    var materialTypes = (List<SelectListItem>)ViewBag.MaterialTypes;
}

<h2 class="text-center mb-4">Availability Report</h2>

<!-- Search Form -->
@using (Html.BeginForm("AvailabilityReport", "Librarian", FormMethod.Get))
{
    <div style="margin-bottom:16px; display:flex; gap:15px; align-items:center; flex-wrap:wrap;">
        <div>
            <label>Title:</label>
            @Html.TextBox("title", Request.QueryString["title"] ?? "", new { @class = "form-control", id = "titleBox", placeholder = "Enter Title" })
        </div>
        <div>
            <label>Author:</label>
            @Html.TextBox("author", Request.QueryString["author"], new { @class = "form-control", id = "authorBox", placeholder = "Enter Author" })
        </div>
        @*<div>
            <label>Book Type:</label>
            @Html.DropDownList("materialType", materialTypes, "Select Material Type", new { @class = "form-control" })
        </div>*@
        <div style="margin-top:25px;">
            <input type="submit" value="Search" class="btn btn-primary" />
            <a href="@Url.Action("AvailabilityReport", "Librarian")" class="btn btn-secondary">Clear</a>
        </div>
    </div>
}

<!-- Results Table -->
<div style="max-height:600px; overflow-y:auto;">
    @if (Model != null && Model.Any())
    {
        <table class="table table-bordered table-striped">
            <thead class="table-dark">
                <tr>
                    <th>Title</th>
                    <th>Author</th>
                    <th>Book Type</th>
                    <th>Total Quantity</th>
                    <th>Available Quantity</th>
                    <th>Issued Quantity</th>
                    <th>Book Lost Quantity</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.AuthorName</td>
                        <td>@item.MaterialType</td>
                        <td>@item.TotalQuantity</td>
                        <td>@item.AvailableQuantity</td>
                        <td>@item.IssuedQuantity</td>
                        <td>@item.BookLostQuantity</td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-danger">No records found.</p>
    }
</div>

@section Scripts {
    <link href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

 
 <style>
    /* Make autocomplete dropdown scrollable */
    .ui-autocomplete {
        max-height: 200px;   /* adjust height as needed */
        overflow-y: auto;    /* vertical scroll */
        overflow-x: hidden;  /* hide horizontal scroll */
        z-index: 1000 !important; /* ensure it appears above other elements */
    }
    /* Optional: prevent menu width from stretching too wide */
    .ui-autocomplete li {
        white-space: nowrap;
    }
</style>

<script>
$(function () {
    // --- Initial data from ViewBag ---
    var allTitles = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Titles));
    var allAuthors = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.Authors));
    var authorDropdownInitialized = false;

    // --- Default setup ---
    $("#titleBox").autocomplete({ source: allTitles });
    makeAuthorAutocomplete(allAuthors); // Author editable from start

    // --- When Title or Material Type changes ---
    $("#titleBox, select[name='materialType']").on("change", function () {
        var title = $("#titleBox").val();
        var materialType = $("select[name='materialType']").val();

        // Only convert Author to dropdown once, after first Title/Type selection
        if ((title || materialType) && !authorDropdownInitialized) {
            $.ajax({
                url: '@Url.Action("GetFilteredData", "Librarian")',
                data: { title: title, materialType: materialType },
                success: function (data) {
                    convertAuthorToDropdown(data.Authors);

                    // Update Material Type dropdown if Title is selected
                    var $matType = $("select[name='materialType']");
                    if (title) {
                        $matType.empty().append('<option value="">Select Material Type</option>');
                        $.each(data.MaterialTypes, function (i, val) {
                            $matType.append($('<option>', { text: val, value: val }));
                        });
                    }

                    authorDropdownInitialized = true; // prevent future resets
                }
            });
        }
    });

    // --- Always allow typing in Author, even if nothing selected ---
    $(document).on("focus", "#authorBox", function () {
        if (!authorDropdownInitialized) {
            makeAuthorAutocomplete(allAuthors); // autocomplete active
        }
    });

    // --- Utility: Convert Author to dropdown ---
    function convertAuthorToDropdown(authors) {
        var $container = $("#authorBox").parent();
        var currentValue = $("#authorBox").val(); // preserve typed value
        $("#authorBox").remove();
        var $dropdown = $('<select id="authorBox" name="author" class="form-control"></select>');
        $dropdown.append('<option value="">Select Author</option>');
        $.each(authors, function (i, val) {
            $dropdown.append($('<option>', { value: val, text: val }));
        });

        if (currentValue && authors.includes(currentValue)) {
            $dropdown.val(currentValue);
        }

        $container.append($dropdown);
    }

    // --- Utility: Convert Author back to text input ---
    function convertAuthorToTextbox() {
        var $container = $("#authorBox").parent();
        var previousValue = $("#authorBox").val() || "";
        $("#authorBox").remove();
        var $textbox = $('<input type="text" id="authorBox" name="author" class="form-control" placeholder="Enter Author">');
        $textbox.val(previousValue);
        $container.append($textbox);
    }

    // --- Utility: Apply autocomplete ---
    function makeAuthorAutocomplete(sourceList) {
        $("#authorBox").autocomplete({
            source: sourceList,
            delay: 100,
            minLength: 0 // show all on focus if needed
        }).focus(function(){
            $(this).autocomplete("search", $(this).val()); // open dropdown on focus
        });
    }
});
    </script>


 
}
