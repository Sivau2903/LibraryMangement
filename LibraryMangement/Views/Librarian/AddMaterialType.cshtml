@model List<LibraryMangement.Models.MaterialType>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Add Material Type";
}

<h2 class="text-center my-4">Manage Libarary Resource Types</h2>
<style>
    @@media (min-width: 768px) {
        .col-md-4 {
            flex: 0 0 auto;
            width: 27%;
            margin-top:2%;
        }
    }
</style>
<div class="row justify-content-center">
    <!-- Left: Existing Material Types Table -->
    <div class="col-md-7">
        <h4>Existing Types</h4>

        @if (Model != null && Model.Count > 0)
        {
            <table class="table table-striped table-bordered shadow-sm rounded">
                <thead class="table-light text-center">
                    <tr>
                        <th>S.NO</th>
                        <th>Type Name</th>
                        <th>Action</th>
                        <th>(Click to make Active/InActive)</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr id="row-@Model[i].MaterialTypeID">
                            <td class="text-center">@(i + 1)</td>
                            <td>
                                <input type="text" class="form-control form-control-sm type-name-input"
                                       value="@Model[i].TypeName" data-id="@Model[i].MaterialTypeID" />
                            </td>
                            <td class="text-center">
                                <button class="btn btn-success btn-sm save-btn" data-id="@Model[i].MaterialTypeID">Save</button>
                            </td>
                            <td class="text-center">
                                <button class="btn btn-sm toggle-status-btn" data-id="@Model[i].MaterialTypeID" data-status="@Model[i].IsActive"
                                         style="width: 80px; color: white; font-weight: bold;">
                                    @(Model[i].IsActive == true ? "Active" : "Inactive")
                                </button>
                            </td>
                       
                        </tr>
                    }
                </tbody>

            </table>
        }
        else
        {
            <p class="text-muted">No Book types added yet.</p>
        }
    </div>

    <!-- Right: Add Material Type Card -->
    <div class="col-md-4">
        <div class="card shadow rounded-3">
            <div class="card-header bg-primary text-white text-center">
                <h5 class="mb-0">Add New Library Resource Type</h5>
            </div>

            <div class="card-body">
                <!-- Alerts -->
                <div id="add-alert-container">
                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>

                <!-- Add Form -->
                <form id="addForm" method="post" action="@Url.Action("AddMaterialType", "Librarian")">
                    @Html.AntiForgeryToken()
                    <div class="mb-3" style="width:50%;">
                        <label class="form-label fw-bold"> Type Name</label>
                        <input type="text" id="NewTypeName" class="form-control" name="TypeName" placeholder="Enter book type name" required />
                    </div>
                    <div class="text-end" style="width:50%">
                        <button type="button" class="btn btn-primary w-100" id="addConfirmBtn">Add </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="confirmModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">
                Are you sure you want to proceed?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalConfirmBtn">Yes, Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            var currentEditId = 0;
            var currentNewName = "";

            // Inline edit save button
            $(".save-btn").click(function () {
                currentEditId = $(this).data("id");
                var newName = $(this).closest("tr").find(".type-name-input").val();
                currentNewName = newName;

                if (!newName) {
                    alert("Type Name cannot be empty!");
                    return;
                }

                // Show confirmation modal
                $("#confirmModalBody").text("Are you sure you want to save changes to this Book Type?");
                $("#confirmModal").modal("show");

               $("#modalConfirmBtn").off("click").on("click", function () {
    $.ajax({
        url: '/Librarian/UpdateMaterialType', // hardcoded to be sure
        type: 'POST',
        data: {
            id: currentEditId,
            typeName: currentNewName,
            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
        },
        success: function (response) {
            if (response.success) {
                alert("Book Type updated successfully!");
                // Update the input field with saved value
                $('#row-' + currentEditId).find('.type-name-input').val(currentNewName);
            } else {
                alert("Error: " + response.message);
            }
            $("#confirmModal").modal("hide");
        },
        error: function (xhr) {
            alert("An error occurred: " + xhr.responseText);
            $("#confirmModal").modal("hide");
        }
    });
});

            });

            // Add new type confirmation
            $("#addConfirmBtn").click(function () {
                var typeName = $("#NewTypeName").val().trim();
                if (!typeName) {
                    alert("Please enter a Book Type name!");
                    return;
                }
                currentNewName = typeName;
                $("#confirmModalBody").text("Are you sure you want to add this new Book Type?");
                $("#confirmModal").modal("show");

                $("#modalConfirmBtn").off("click").on("click", function () {
                    $("#addForm").submit();
                });
            });

            // Function to set button color based on status
            function setStatusButtonColor(button, status) {
                if (status) {
                    button.css("background-color", "green");
                    button.css("border-color", "green");
                } else {
                    button.css("background-color", "red");
                    button.css("border-color", "red");
                }
            }

            $(".toggle-status-btn").each(function () {
                var status = $(this).data("status") === true || $(this).data("status") === "True";
                setStatusButtonColor($(this), status);
            });

            // Toggle Active / Inactive button
            $(".toggle-status-btn").click(function () {
                var id = $(this).data("id");
                var currentStatus = parseInt($(this).data("status")); // ensure it's int
                var button = $(this);

                var newStatus = currentStatus == 1 ? 0 : 1;
                var confirmText = currentStatus == 1 ? "deactivate" : "activate";

                // Show confirmation
                $("#confirmModalBody").text("Are you sure you want to " + confirmText + " this Book Type?");
                $("#confirmModal").modal("show");

                $("#modalConfirmBtn").off("click").on("click", function () {
                    $.ajax({
                        url: '/Librarian/ToggleMaterialTypeStatus',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                button.text(newStatus == 1 ? "Active" : "Inactive");
                                button.data("status", newStatus);
                                alert("Status updated successfully!");
                            } else {
                                alert("Error: " + response.message);
                            }
                            $("#confirmModal").modal("hide");
                        },
                        error: function (xhr) {
                            alert("An error occurred: " + xhr.responseText);
                            $("#confirmModal").modal("hide");
                        }
                    });
                });
            });



        });
    </script>
}
