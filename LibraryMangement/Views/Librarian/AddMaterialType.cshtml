@model List<LibraryMangement.Models.MaterialType>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Add Material Type";
}

<h2 class="text-center my-4">Manage Material Types</h2>

<div class="row">
    <!-- Left: Existing Material Types Table -->
    <div class="col-md-6">
        <h4>Existing Material Types</h4>

        @if (Model != null && Model.Count > 0)
        {
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Type Name</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.Count; i++)
                    {
                        <tr>
                            <td>@(i + 1)</td>
                            <td>@Model[i].TypeName</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted">No material types added yet.</p>
        }
    </div>

    <!-- Right: Add Material Type Form -->
    <div class="col-md-6">
        <h4>Add New Material Type</h4>

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">@TempData["Error"]</div>
        }

        <form method="post" action="@Url.Action("AddMaterialType", "Librarian")">
            @Html.AntiForgeryToken()

            <div class="mb-3">
                <label class="form-label">Material Type Name</label>
                <input type="text" class="form-control" name="TypeName" placeholder="Enter material type name" required />
            </div>

            <button type="submit" class="btn btn-primary">Add Material Type</button>
        </form>
    </div>
</div>
