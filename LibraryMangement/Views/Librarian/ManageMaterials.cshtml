@model IEnumerable<LibraryMangement.Models.MaterialViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Materials";
    string designation = Session["Designation"]?.ToString();
}

<h2 class="mb-4">Manage Library Resources</h2>
<style>
    .content {
        flex: 1;
        padding: -10px;
        background-color: #f8f9fa;
    }
    .dataTables_wrapper {
        position: relative;
        clear: both;
        margin-top: -20px;
    }
</style>
@if (TempData["Success"] != null)
{
    <div class="success-overlay d-flex align-items-center justify-content-center">
        <div class="text-center">
            <i class="bi bi-check-circle-fill display-2 text-success animate-pop"></i>
            <h5 class="mt-2 text-success fw-bold">@TempData["Success"]</h5>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-2">@TempData["Error"]</div>
}

@if (Model != null && Model.Any())
{
    <table id="MaterialsTable" class="table table-hover table-striped display" style="width: 100%">
        <thead class="table-primary text-uppercase small">
            <tr>
                <th>Material ID</th>
                <th>Title</th>
                <th>Author</th>
                <th>Edition</th>
              
                <th>Publishers</th>
                <th>Year</th>
                <th>Pages</th>
                <th>Volume</th>
                <th>Book Type</th>
                <th>Available Quantity</th>
                <th>Status Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var material in Model)
            {
                <tr>
                    <td>@material.MaterialID</td>
                    <td>@material.Title</td>
                    <td>@material.Author</td>
                    <td>@material.Edition</td>
                 
                    <td>@material.PlaceofPublishers</td>
                    <td>@material.YearPublished</td>
                    <td>@material.Pages</td>
                    <td>@material.Vol</td>
                    <td>@material.MaterialType</td>
                    <td>@material.AvailableQuantity</td>
                    <td>
                        @if (designation == "Librarian")
                        {
                            <a class="btn btn-sm btn-primary shadow-sm" href="@Url.Action("EditMaterial", new { id = material.MaterialID })">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>
                        }
else
                    {
                        <p>Nill</p>
                    }
                        </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-center text-muted">No materials available.</p>
}

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#MaterialsTable').DataTable({
                scrollY: "550px",
                paging: true,
                searching: true,
                ordering: true,
                info: true,
                responsive: true,
                columnDefs: [{ orderable: false, targets: 10 }] // Action column
            });
        });
    </script>
}
