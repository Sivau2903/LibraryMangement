@model List<LibraryMangement.Models.MaterialBulkUploadPreviewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Bulk Upload Materials";
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

<h2>Add Bulk Library Resource</h2>

<p>Please upload an Excel (.xlsx) file with the following columns in this order:</p>

<div class="container my-4">
    <!-- Top Row: Upload + Template -->
    <div class="d-flex justify-content-between align-items-start mb-3">
        <!-- Left: Upload Form -->
        <div class="p-3 border rounded" style="flex: 0 0 60%;">
            <h4>Upload Excel File</h4>
            <form id="bulkUploadForm" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="mb-3" style="max-width: 30%;">
                    <label class="form-label">Select Excel File (.xlsx)</label>
                    <input type="file" id="uploadFile" accept=".xlsx" class="form-control" />
                </div>
                <button type="button" class="btn btn-primary" id="previewBtn">Preview</button>
                <button type="button" class="btn btn-success" id="saveBtn" style="display:none;">Save All</button>
                <button type="button" class="btn btn-danger btn-sm" id="deleteSelectedBtn">Delete Selected</button>
            </form>
        </div>

        <!-- Right: Template -->
        <div class="p-3 border rounded text-center" style="flex: 0 0 35%;">
            <h4>Standard Template</h4>
            <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#templateModal">View Template</button>
        </div>
    </div>

    <!-- Full-width Preview Table -->
    <div id="previewTableContainer" class="p-3 border rounded" style="max-height:500px; overflow:auto;">
        <!-- Preview table will be rendered here -->
    </div>

    <!-- Delete Selected Button -->
    @*<div class="my-2 d-flex justify-content-end">
        <button type="button" class="btn btn-danger btn-sm" id="deleteSelectedBtn">Delete Selected</button>
    </div>*@
</div>

<!-- Template Modal -->
<div class="modal fade" id="templateModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title">Bulk Upload Template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body table-responsive" style="max-height:500px; overflow:auto;">
                <table class="table table-bordered table-striped">
                    <thead>
                        <tr>
                            <th>Sl.No</th>
                            <th>Title</th>
                            <th>Author</th>
                            <th>Place of Publishers</th>
                            <th>Year</th>
                            <th>ISBN</th>
                            <th>Edition</th>
                            <th>Pages</th>
                            <th>Vol.</th>
                            <th>Source</th>
                            <th>Price</th>
                            <th>Library Resource Type</th>
                            <th>Total Quantity</th>
                        </tr>
                    </thead>
                </table>
                <p>Note: Upload 500-1000 Library Resources at a time, not more than that.</p>
            </div>
            <div class="modal-footer">
                <a href="@Url.Action("DownloadBulkTemplate", "Librarian")" class="btn btn-success">
                    Download Template
                </a>


                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Loading Modal -->
<div class="modal fade" id="loadingModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-center p-4">
            <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status"></div>
            <h5 class="mt-3">Saving data, please wait...</h5>
            <p>Do not close this tab until the process completes.</p>
        </div>
    </div>
</div>

<script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>

<script>
    let previewData = [];
    let currentRequest = null;
    let loadingModal = new bootstrap.Modal(document.getElementById('loadingModal'));

    const expectedHeaders = [
        "Sl. No", "Title of the Book", "Author",
        "Place of Publishers", "Year", "Edition", "pages", "Vol.",
        "Source", "Price"
    ];

    document.getElementById('previewBtn').addEventListener('click', function () {
        const fileInput = document.getElementById('uploadFile');
        if (!fileInput.files.length) {
            alert("Please select an Excel file");
            return;
        }

        const file = fileInput.files[0];
        const reader = new FileReader();

        reader.onload = function (e) {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const sheetName = workbook.SheetNames[0];
            const worksheet = workbook.Sheets[sheetName];

            const rawData = XLSX.utils.sheet_to_json(worksheet, { header: 1, defval: "" });
            if (!rawData.length) {
                alert("No data found in Excel!");
                return;
            }

            const excelHeaders = rawData[0];
            const missingHeaders = expectedHeaders.filter(h => !excelHeaders.includes(h));
            if (missingHeaders.length) {
                alert("Excel headers are invalid or missing:\n" + missingHeaders.join(", "));
                return;
            }

            const dataRows = rawData.slice(1);
            previewData = dataRows.map((row, index) => ({
                RowIndex: parseInt(row[0]) || index + 1,
                //AccountNumber: row[1] || "",
                //CallNumber: row[2] || "",
                Title: row[1] || "",
                AuthorName: row[2] || "",
                PlaceofPublishers: row[3] || null,
                YearPublished: parseInt(row[4]) || null,
                Edition: row[5] || null,
                Pages: parseInt(row[6]) || null,
                Vol: row[7] || null,
                Source: row[8] || null,
                Price: parseFloat(row[9]) || null,
                IsDuplicate: false,
                IsDeleted: false
            }));

            renderPreviewTable(previewData);
        };

        reader.readAsArrayBuffer(file);
    });

    function renderPreviewTable(data) {
        if (!data.length) return;

        const tableHeaders = [
            "RowIndex", "Title", "AuthorName", "PlaceofPublishers",
            "YearPublished", "Edition", "Pages", "Vol", "Source", "Price"
        ];

        let html = `<table class="table table-bordered mt-3"><thead><tr>`;
        html += `<th><input type="checkbox" id="selectAll"></th>`;
        tableHeaders.forEach(header => html += `<th>${header}</th>`);
        html += `<th>Action</th></tr></thead><tbody>`;

        data.forEach((row, index) => {
            html += `<tr data-index="${index}">`;
            html += `<td><input type="checkbox" class="rowCheckbox"></td>`;
            tableHeaders.forEach(header => {
                html += `<td><input type="text" class="form-control" value="${row[header] ?? ''}" data-key="${header}" /></td>`;
            });
            html += `<td><button type="button" class="btn btn-danger btn-sm deleteRow">Delete</button></td>`;
            html += `</tr>`;
        });

        html += `</tbody></table>`;
        document.getElementById('previewTableContainer').innerHTML = html;
        document.getElementById('saveBtn').style.display = 'inline-block';

        // Row Delete Button
        document.querySelectorAll('.deleteRow').forEach(btn => {
            btn.addEventListener('click', function () {
                if (!confirm("Are you sure you want to delete this row?")) return;
                const tr = this.closest('tr');
                const idx = tr.dataset.index;
                previewData.splice(idx, 1);
                tr.remove();
                document.querySelectorAll('#previewTableContainer tbody tr').forEach((row, i) => row.dataset.index = i);
            });
        });

        // Checkbox select/deselect all
        document.getElementById('selectAll').addEventListener('change', function () {
            document.querySelectorAll('.rowCheckbox').forEach(cb => cb.checked = this.checked);
        });

        // Input change event
        document.querySelectorAll('#previewTableContainer input[type=text]').forEach(input => {
            input.addEventListener('change', function () {
                const tr = this.closest('tr');
                const idx = tr.dataset.index;
                const key = this.dataset.key;
                let value = this.value;

                if (["Pages", "YearPublished", "RowIndex"].includes(key)) {
                    previewData[idx][key] = parseInt(value) || null;
                } else if (key === "Price") {
                    previewData[idx][key] = parseFloat(value) || null;
                } else {
                    previewData[idx][key] = value || null;
                }
            });
        });
    }

    // Delete multiple selected rows
    document.getElementById('deleteSelectedBtn').addEventListener('click', function () {
        const selected = document.querySelectorAll('.rowCheckbox:checked');
        if (selected.length === 0) {
            alert("Please select at least one row to delete.");
            return;
        }

        if (confirm(`Are you sure you want to delete ${selected.length} selected row(s)?`)) {
            selected.forEach(cb => {
                const tr = cb.closest('tr');
                const idx = tr.dataset.index;
                previewData.splice(idx, 1);
                tr.remove();
            });
            // Re-index remaining rows
            document.querySelectorAll('#previewTableContainer tbody tr').forEach((row, i) => row.dataset.index = i);
        }
    });

    document.querySelector('.btn.btn-success').addEventListener('click', function () {
        const modal = bootstrap.Modal.getInstance(document.getElementById('templateModal'));
        modal.hide();
    });

    // Save Button
    document.getElementById('saveBtn').addEventListener('click', function () {
        if (!previewData.length) {
            alert("No data to save!");
            return;
        }

        const token = $('input[name="__RequestVerificationToken"]').val();
        loadingModal.show();

        currentRequest = $.ajax({
            url: '/Librarian/BulkUploadMaterialsAjax',
            type: 'POST',
            headers: { 'RequestVerificationToken': token },
            data: { materialsJson: JSON.stringify(previewData) },
            success: function (res) {
                loadingModal.hide();
                currentRequest = null;

                if (res.success) {
                    alert("Materials saved successfully!");
                    previewData = [];
                    $('#previewTableContainer').html('');
                    $('#saveBtn').hide();
                    $('#uploadFile').val('');
                } else {
                    alert("Error: " + res.message);
                }
            },
            error: function (err) {
                loadingModal.hide();
                currentRequest = null;

                if (err.statusText === "abort") {
                    alert("Saving was cancelled!");
                } else {
                    alert("Error saving materials.");
                    console.error(err);
                }
            }
        });
    });
</script>
