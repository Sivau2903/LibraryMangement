@model IEnumerable<LibraryMangement.Models.IssueMaterialViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Issue Material";
}

<style>
    @@media (min-width: 1200px) {
        .container {
            margin-top: -60px;
        }
    }

    .alert-floating {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 3000;
        min-width: 250px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .modal-dialog-top {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%);
        margin: 0;
    }

    .modal-content {
        border-radius: 10px;
    }

    .modal-backdrop.show {
        opacity: 0.3;
    }
</style>

<h2 class="text-center my-4">Issue Reserved Library Resource</h2>

<div class="container" style="font-size:1.1rem;">
    @Html.AntiForgeryToken()

    <!-- Role Selection -->
    <div class="mb-3">
        <label for="roleSelect" class="form-label fw-bold">Select Role:</label>
        <select id="roleSelect" class="form-select" style="width:15%;">
            <option value="Student" @(ViewBag.SelectedRole == "Student" ? "selected" : "")>Student</option>
            <option value="Faculty" @(ViewBag.SelectedRole == "Faculty" ? "selected" : "")>Faculty</option>
        </select>
    </div>

    <!-- Filter by Patron ID -->
    <div class="mb-4">
        <label for="patronFilter" class="form-label fw-bold">Filter by Patron ID:</label>
        <input type="text" id="patronFilter" class="form-control" placeholder="Type Patron ID to filter..." style="width:22%;">
    </div>

    <!-- Reserved Materials Table -->
    <div class="table-responsive" style="max-height:500px; overflow-y:auto;">
        <table class="table table-bordered table-hover mb-0" id="reservedTable">
            <thead class="table-primary text-uppercase small sticky-top">
                <tr>
                    <th>Select</th>
                    <th>@(ViewBag.SelectedRole == "Faculty" ? "Faculty Name" : "Student Name")</th>
                    <th>Patron ID</th>
                    <th>Email ID</th>
                    <th>Type Of Patron</th>
                    <th>Title</th>
                    <th>Requested Date</th>
                    <th>Status</th>
                    <th>Available Barcode</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="reserve-select"
                                   data-circid="@item.CirculationID"
                                   data-materialid="@item.MaterialID"
                                   data-patronid="@item.UserID" />
                        </td>
                        <td>@item.UserName</td>
                        <td class="patron-id">@item.UserID</td>
                        <td>@item.UserEmail</td>
                        <td>@item.PatronType</td>
                        <td>@item.MaterialTitle</td>
                        <td>@item.RequestedDate?.ToString("dd-MMM-yyyy")</td>
                        <td>@item.Status</td>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                <select class="form-select reserve-barcode" data-circid="@item.CirculationID" data-materialid="@item.MaterialID">
                                    <option value="">-- Select Barcode --</option>
                                </select>
                                <button class="btn btn-sm btn-warning print-barcode-btn" style="display:none;">Print</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button class="btn btn-success mb-4" id="issueSelectedReserves" style="font-size:1.1rem;">Issue Selected</button>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmIssueModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-top">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title fw-bold" id="confirmModalLabel">Confirm Issue</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-3">
                <p>Are you sure you want to issue the selected materials?</p>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success btn-sm" id="confirmIssueBtn">Yes, Issue</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="alertContainer"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script>
        $(document).ready(function () {

            // Patron Filter
            $('#patronFilter').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $("#reservedTable tbody tr").filter(function () {
                    $(this).toggle($(this).find('.patron-id').text().toLowerCase().indexOf(value) > -1);
                });
            });

               // Role change: reload page with selected role
            $('#roleSelect').change(function () {
                var role = $(this).val();
                window.location.href = '@Url.Action("IssueMaterial","Librarian")?selectedRole=' + role;
            });

            // Patron Filter
            $('#patronFilter').on('keyup', function () {
                var value = $(this).val().toLowerCase();
                $("#reservedTable tbody tr").filter(function () {
                    $(this).toggle($(this).find('.patron-id').text().toLowerCase().indexOf(value) > -1);
                });
            });

            // Load Barcodes dynamically
            $(document).on('focus', '.reserve-barcode', function () {
                var dropdown = $(this);
                var materialId = dropdown.data('materialid');
                if (!materialId) return;

                if (dropdown.children('option').length === 1) {
                    $.get('/Librarian/GetAvailableBarcodes', { materialId: materialId })
                        .done(function (response) {
                            if (response.success) {
                                dropdown.empty().append('<option value="">-- Select Barcode --</option>');
                                $.each(response.barcodes, function (i, code) {
                                    var printedText = code.IsPrinted ? " (Printed)" : "";
                                    dropdown.append(`<option value="${code.Barcode}" data-isprinted="${code.IsPrinted}">${code.Barcode}${printedText}</option>`);
                                });
                            }
                        })
                        .fail(function () {
                            dropdown.empty().append('<option>Error loading barcodes</option>');
                        });
                }
            });

            // Show Print Button if barcode not printed
            $(document).on('change', '.reserve-barcode', function () {
                var selectedOption = $(this).find('option:selected');
                var printBtn = $(this).siblings('.print-barcode-btn');
                printBtn.toggle(selectedOption.data('isprinted') === false);
            });

            // Print Barcode
            $(document).on('click', '.print-barcode-btn', function () {
                var dropdown = $(this).siblings('.reserve-barcode');
                var barcode = dropdown.val();
                if (!barcode) { alert("Select a barcode first."); return; }

                var printWindow = window.open('', '_blank');
                printWindow.document.write(`<html><head><title>Print Barcode</title></head><body>`);
                printWindow.document.write(`<h3>Barcode: ${barcode}</h3><svg id="barcode"></svg>`);
                printWindow.document.write(`<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"><\/script>`);
                printWindow.document.write(
                    '<script>' +
                    'JsBarcode("#barcode", "' + barcode + '", { format: "CODE128", width: 2, height: 60 });' +
                    'window.print();' +
                    '<\/script>'
                );
                printWindow.document.write(`</body></html>`);

                // Mark as printed
                $.post('/Librarian/MarkBarcodePrinted', { barcode: barcode, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() })
                    .done(function () {
                        dropdown.find('option:selected').text(barcode + " (Printed)").data('isprinted', true);
                        $(this).hide();
                    });
            });

            // Issue Selected
            $('#issueSelectedReserves').click(function () {
                var selected = [];
                $('.reserve-select:checked').each(function () {
                    var circId = $(this).data('circid');
                    var patronId = $(this).data('patronid');
                    var barcode = $(this).closest('tr').find('.reserve-barcode').val();

                    if (!barcode) {
                        showAlert('Please select a barcode for all selected items.', 'danger');
                        selected = [];
                        return false;
                    }

                    selected.push({ CirculationID: circId, PatronID: patronId, Barcode: barcode });
                });

                if (!selected.length) { showAlert('Select at least one reserve to issue.', 'warning'); return; }

                window.selectedReserves = selected;
                $('#confirmIssueModal').modal('show');
            });

            // Confirm Issue
            $('#confirmIssueBtn').click(function () {
                $.ajax({
                    url: '/Librarian/IssueSelectedReserves',
                    method: 'POST',
                    data: {
                        patronId: window.selectedReserves[0].PatronID,   // ✅ Correct property
                        selectedReserves: window.selectedReserves,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (data) {
                        $('#confirmIssueModal').modal('hide');
                        if (data.success) {
                            showAlert('Selected materials issued successfully!', 'success');
                            setTimeout(() => location.reload(), 2500);
                        } else {
                            showAlert(data.message || 'Error issuing reserves.', 'danger');
                        }
                    },
                    error: function () {
                        $('#confirmIssueModal').modal('hide');
                        showAlert('An error occurred while issuing materials.', 'danger');
                    }
                });
            });


            // Show Alert
            function showAlert(message, type) {
                var alertBox = $(`
                        <div class="alert alert-${type} alert-dismissible fade show alert-floating">
                            ${message}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>`);
                $('#alertContainer').append(alertBox);
                setTimeout(() => alertBox.alert('close'), 4000);
            }

        });
    </script>
}
