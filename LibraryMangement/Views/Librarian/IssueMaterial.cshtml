@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Issue Material";
}

<h2 class="my-4 text-center" style="font-size:2rem;">Issue Material</h2>

<div class="container" style="font-size:1.1rem;">
    @Html.AntiForgeryToken()

    <div class="row">
        <!-- Left: Patron Details -->
        <div id="patronDetails" class="col-md-4 border rounded p-4 bg-light" style="display: none; font-size:1.1rem;">
            <h4 class="mb-3">Patron Details</h4>
            <p><strong>Name:</strong> <span id="patronName"></span></p>
            <p><strong>Email:</strong> <span id="patronEmail"></span></p>
            <p><strong>Phone:</strong> <span id="patronPhone"></span></p>
            <p><strong>Type:</strong> <span id="patronType"></span></p>
        </div>

        <!-- Right: Tabs and Reserve Issue -->
        <div class="col-md-8">

            <!-- Patron ID Input -->
            <div class="mb-4">
                <label for="patronId" class="form-label" style="font-size:1.1rem;">Patron ID</label>
                <div class="input-group" style="width:40%;">
                    <input type="text" id="patronId" class="form-control" placeholder="Enter Patron ID" style="font-size:1.1rem;" />
                    <button class="btn btn-primary" id="searchPatron" style="font-size: 1.0rem;  margin-left: 10px;">Search</button>
                </div>
            </div>

            <!-- Tabs Section -->
            <div id="patronActivities" style="display: none;">
                <ul class="nav nav-tabs mb-3" id="activityTabs" role="tablist">
                    <li class="nav-item">
                        <button class="nav-link active" id="issues-tab" data-bs-toggle="tab" data-bs-target="#issuesTab" style="font-size:1.1rem;">Issued</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="reserves-tab" data-bs-toggle="tab" data-bs-target="#reservesTab" style="font-size:1.1rem;">Reserved</button>
                    </li>
                    <li class="nav-item">
                        <button class="nav-link" id="bookings-tab" data-bs-toggle="tab" data-bs-target="#bookingsTab" style="font-size:1.1rem;">Bookings</button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Issues Table -->
                    <div class="tab-pane fade show active" id="issuesTab">
                        <h5 class="mb-3" style="font-size:1.2rem;">Issued Items</h5>
                        <table class="table table-striped table-hover table-bordered" style="font-size:1.1rem;">
                            <thead class="table-dark">
                                <tr style="font-size:1.1rem;">
                                    <th>Circulation ID</th>
                                    <th>Title</th>
                                    <th>Issued Date</th>
                                    <th>Due Date</th>
                                    <th>Status</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>

                    <!-- Reserves Table -->
                    <div class="tab-pane fade" id="reservesTab">
                        <h5 class="mb-3" style="font-size:1.2rem;">Reserved Items</h5>
                        @*<button class="btn btn-success mb-2" id="issueSelectedReserves" style="font-size:1.1rem;">Issue Selected</button>*@
                        <table class="table table-striped table-hover table-bordered" style="font-size:1.1rem;">
                            <thead>
                                <tr>
                                    <th>Select</th>
                                    <th>Circulation ID</th>
                                    <th>Title</th>
                                    <th>Requested Date</th>
                                    <th>Status</th>
                                    <th>Available Barcode</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                        <button class="btn btn-success mb-2" id="issueSelectedReserves" style="font-size:1.1rem;">Issue Selected</button>
                    </div>

                    <!-- Bookings Table -->
                    <div class="tab-pane fade" id="bookingsTab">
                        <h5 class="mb-3" style="font-size:1.2rem;">Active Bookings</h5>
                        <table class="table table-striped table-hover table-bordered" style="font-size:1.1rem;">
                            <thead>
                                <tr>
                                    <th>Booking ID</th>
                                    <th>Title</th>
                                    <th>Booked Date</th>
                                    <th>Expiry Date</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script>
        $(document).ready(function () {

            function parseDate(jsonDate) {
                if (!jsonDate) return '';
                var timestamp = parseInt(jsonDate.replace(/\/Date\((-?\d+)\)\//, '$1'));
                return new Date(timestamp).toLocaleDateString();
            }

            // Search Patron
            $('#searchPatron').click(function () {
                var patronId = $('#patronId').val();
                var token = $('input[name="__RequestVerificationToken"]').val();

                $.post('/Librarian/ValidatePatronId', {
                    __RequestVerificationToken: token,
                    patronId: patronId
                }, function (data) {
                    if (data.exists) {
                        $('#patronName').text(data.patron.PatronName);
                        $('#patronEmail').text(data.patron.PatronEmail);
                        $('#patronPhone').text(data.patron.PatronPhone);
                        $('#patronType').text(data.patron.PatronType);

                        $('#patronDetails').show();
                        $('#patronActivities').show();

                        populateTable('#issuesTable tbody', data.issues, 'issues');
                        populateTable('#reservesTable tbody', data.reserves, 'reserves');
                        populateTable('#bookingsTable tbody', data.bookings, 'bookings');
                    } else {
                        alert('Patron ID not found.');
                        $('#patronDetails').hide();
                        $('#patronActivities').hide();
                    }
                });
            });

            // Populate Tables
            function populateTable(selector, data, type) {
                let rows = '';
                data.forEach(function (item) {
                    if (type === 'issues') {
                        rows += `<tr>
                            <td>${item.CirculationID}</td>
                            <td>${item.MaterialTitle}</td>
                            <td>${item.IssueDate ? parseDate(item.IssueDate) : ''}</td>
                            <td>${item.DueDate ? parseDate(item.DueDate) : ''}</td>
                            <td class="${item.Status === 'Issued' ? 'text-success fw-bold' : (item.Status === 'OverDue' ? 'text-danger fw-bold' : '')}">
                                ${item.Status}
                            </td>
                             <td class="text-center">
                        <a href="/Librarian/ReturnMaterial/" class="btn btn-sm btn-danger">Return</a>
                        <a href="/Librarian/ReturnMaterial/" class="btn btn-sm btn-warning">Renew</a>
                    </td>
                        </tr>`;
                    } else if (type === 'reserves') {
                        rows += `<tr>
                            <td><input type="checkbox" class="reserve-select" data-circid="${item.CirculationID}" data-materialid="${item.MaterialID}" /></td>
                            <td>${item.CirculationID}</td>
                            <td>${item.MaterialTitle}</td>
                            <td>${item.RequestDate ? parseDate(item.RequestDate) : ''}</td>
                            <td>${item.Status}</td>
                            <td>

        <select class="form-select reserve-barcode"
                data-circid="${item.CirculationID}"
                data-materialid="${item.MaterialID}">
            <option value="">-- Select Barcode --</option>
        </select>
</td>




                        </tr>`;
                    } else if (type === 'bookings') {
                        rows += `<tr>
                            <td>${item.BookingID}</td>
                            <td>${item.MaterialTitle}</td>
                            <td>${item.BookingDate ? parseDate(item.BookingDate) : ''}</td>
                            <td>${item.ExpiryDate ? parseDate(item.ExpiryDate) : ''}</td>
                            <td>${item.Status}</td>
                        </tr>`;
                    }
                });
                $(selector).html(rows);
            }

            // Load barcodes dynamically on focus
            // Load barcodes dynamically on focus
            $(document).on('focus', '.reserve-barcode', function () {
                var dropdown = $(this);
                var materialId = dropdown.data('materialid');
                console.log("Focus on MaterialID:", materialId);

                if (!materialId) return;  // safety check

                if (dropdown.children('option').length === 1) {
                    $.get('/Librarian/GetAvailableBarcodes', { materialId: materialId })
                        .done(function (response) {
                            if (response.success) {
                                dropdown.empty().append('<option value="">-- Select Barcode --</option>');

                                // iterate only over the array of barcodes
                                $.each(response.barcodes, function (i, code) {
                                    dropdown.append('<option value="' + code + '">' + code + '</option>');
                                });

                                // optional: auto-select if only 1 barcode
                                if (response.barcodes.length === 1) {
                                    dropdown.val(response.barcodes[0]);
                                }
                            }
                        })
                        .fail(function (xhr, status, error) {
                            console.error("AJAX fail:", status, error, xhr.responseText);
                            dropdown.empty().append('<option value="">Error loading barcodes</option>');
                        });

                }
            });



            // Issue Selected Reserves
            $('#issueSelectedReserves').click(function () {
                var patronId = $('#patronId').val();
                var selected = [];

                $('.reserve-select:checked').each(function () {
                    var circId = $(this).data('circid');
                    var barcode = $(this).closest('tr').find('.reserve-barcode').val();
                    if (!barcode) {
                        alert('Please select a barcode for selected reserves.');
                        return false;
                    }
                    selected.push({ CirculationID: circId, Barcode: barcode });
                });

                if (selected.length === 0) { alert('Select at least one reserve.'); return; }

                $.post('/Librarian/IssueSelectedReserves', {
                    patronId: patronId,
                    selectedReserves: selected,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                }, function (data) {
                    if (data.success) {
                        alert('Selected reserves issued successfully!');
                        populateTable('#issuesTable tbody', data.issues, 'issues');
                        populateTable('#reservesTable tbody', data.reserves, 'reserves');
                    } else {
                        alert(data.message || 'Error issuing reserves.');
                    }
                });
            });

        });
    </script>
}
