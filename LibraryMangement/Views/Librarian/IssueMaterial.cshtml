@model IEnumerable<LibraryMangement.Models.IssueMaterialViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Issue Material";
}

<style>
    @@media (min-width: 1200px) {
        .container {
            margin-top: -60px;
        }
    }

    .alert-floating {
        position: fixed;
        top: 20px;
        right: 20px;
        z-index: 3000;
        min-width: 250px;
        border-radius: 10px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
    }

    .modal-dialog-top {
        position: fixed;
        top: 80px;
        left: 50%;
        transform: translateX(-50%);
        margin: 0;
    }

    .modal-content {
        border-radius: 10px;
    }

    .modal-backdrop.show {
        opacity: 0.3;
    }
</style>

<h2 class="text-center my-4">Issue Reserved Library Resource</h2>

<div class="container" style="font-size:1.1rem;">
    @Html.AntiForgeryToken()

    <!-- Role Selection -->
    <div class="row mb-3 align-items-end">
        <!-- Select Role -->
        <div class="col-auto">
            <label for="roleSelect" class="form-label fw-bold">Select Role:</label>
            <select id="roleSelect" class="form-select w-auto">
                <option value="Student" @(ViewBag.SelectedRole == "Student" ? "selected" : "")>Student</option>
                <option value="Faculty" @(ViewBag.SelectedRole == "Faculty" ? "selected" : "")>Faculty</option>
            </select>
        </div>


        <!-- Filter by Patron ID -->
        <div class="col-auto">
            <label for="patronFilter" class="form-label fw-bold">Filter by User ID:</label>
            <input type="text" id="patronFilter" class="form-control" placeholder="Type ID..." style="width:200px;">
        </div>
    </div>


    <!-- Reserved Materials Table -->
    <div class="table-responsive" style="max-height:600px;width:100%; overflow-y:auto;">
        <table class="table table-bordered table-hover mb-0" id="reservedTable">
            <thead class="table-primary text-uppercase small sticky-top">
                <tr>
                    <th>Select</th>
                    <th>@(ViewBag.SelectedRole == "Faculty" ? "Faculty Name" : "Student Name")</th>
                    <th>ID</th>
                    @*<th>Email ID</th>*@
                    @*<th>Type Of Patron</th>*@
                    <th>Title</th>
                    <th>Requested Date</th>
                    <th>Status</th>
                    <th>Available Barcode</th>
                    <th>Print Status</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>

                        <td>
                            <input type="checkbox" class="reserve-select"
                                   data-circid="@item.CirculationID"
                                   data-materialid="@item.MaterialID"
                                   data-patronid="@item.UserID" />
                        </td>
                        <td>@item.UserName</td>
                        <td class="user-id">@item.ID</td>
                        @*<td>@item.UserEmail</td>*@
                        @*<td>@item.PatronType</td>*@
                        <td>@item.MaterialTitle</td>
                        <td>@item.RequestedDate</td>
                        <td>@item.Status</td>
                        <td>
                            <select class="form-select reserve-barcode" data-circid="@item.CirculationID" data-materialid="@item.MaterialID">
                                <option value="">-- Select Barcode --</option>
                            </select>
                        </td>
                        <td class="print-status text-center">
                            <span class="badge bg-secondary">N/A</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <button class="btn btn-success mb-4" id="issueSelectedReserves" style="font-size:1.1rem;">Issue Selected</button>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmIssueModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-top">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-warning text-dark py-2">
                <h6 class="modal-title fw-bold" id="confirmModalLabel">Confirm Issue</h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center py-3">
                <p>Are you sure you want to issue the selected materials?</p>
                <div class="d-flex justify-content-center gap-2 mt-2">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-success btn-sm" id="confirmIssueBtn">Yes, Issue</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="alertContainer"></div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
    $(document).ready(function () {

        // 🔹 Patron Filter
        $('#patronFilter').on('keyup', function () {
            var value = $(this).val().toLowerCase();
            $("#reservedTable tbody tr").filter(function () {
                $(this).toggle($(this).find('.user-id').text().toLowerCase().indexOf(value) > -1);
            });
        });

        $('#roleSelect').on('change', function () {
            var role = $(this).val();
            if (!role) return;

            var url = '@Url.Action("IssueMaterial", "Librarian")' + '?selectedRole=' + encodeURIComponent(role);
            window.location.href = url;
        });

        // ----------------------------------------------------------
        // ✅ Load Available Barcodes dynamically
        // ----------------------------------------------------------
        $(document).on('focus', '.reserve-barcode', function () {
            var dropdown = $(this);
            var materialId = dropdown.data('materialid');

            if (!materialId) return;

            // Prevent reloading if already loaded
            if (dropdown.data('loaded') === true) return;

            console.log("Fetching barcodes for MaterialID:", materialId);

            $.ajax({
                url: '@Url.Action("GetAvailableBarcodes", "Librarian", new { area = "" })',
                type: 'GET',
                data: { materialId: materialId },
                success: function (response) {
                    console.log("Barcodes Response:", response);
                    dropdown.empty().append('<option value="">-- Select Barcode --</option>');

                    if (response.success && response.barcodes.length > 0) {
                        $.each(response.barcodes, function (i, code) {
                            dropdown.append(
                                `<option value="${code.Barcode}" data-isprinted="${code.IsPrinted}">
                                    ${code.Barcode}
                                 </option>`
                            );
                        });
                        dropdown.data('loaded', true);
                    } else {
                        dropdown.append('<option value="">No barcodes available</option>');
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error fetching barcodes:", error);
                    dropdown.empty().append('<option value="">Error loading barcodes</option>');
                }
            });
        });

        // ----------------------------------------------------------
        // ✅ Update Print Status Column dynamically
        // ----------------------------------------------------------
        $(document).on('change', '.reserve-barcode', function () {
            var selectedOption = $(this).find('option:selected');
            var row = $(this).closest('tr');
            var printCell = row.find('.print-status');
            var isPrinted = selectedOption.data('isprinted');

            printCell.empty(); // Clear previous content

            if (!$(this).val()) {
                printCell.html('<span class="badge bg-secondary">N/A</span>');
                return;
            }

            if (isPrinted === true) {
                printCell.html(`
                    <span class="badge bg-success">Printed</span>
                    <button class="btn btn-sm btn-outline-primary reprint-barcode-btn ms-2">Reprint</button>
                `);
            } else {
                printCell.html(`
                    <button class="btn btn-sm btn-warning print-barcode-btn">Print</button>
                `);
            }
        });

        // ✅ Print or Reprint Barcode
        $(document).on('click', '.print-barcode-btn, .reprint-barcode-btn', function () {
            var isReprint = $(this).hasClass('reprint-barcode-btn');
            var row = $(this).closest('tr');
            var dropdown = row.find('.reserve-barcode');
            var barcode = dropdown.val();

            if (!barcode) {
                alert("Select a barcode first.");
                return;
            }

            // Open print window
            var printWindow = window.open('', '_blank');
            printWindow.document.write(`<html><head><title>Print Barcode</title></head><body>`);
            printWindow.document.write(`<svg id="barcode"></svg>`);
            printWindow.document.write(`<script src="https://cdn.jsdelivr.net/npm/jsbarcode@3.11.5/dist/JsBarcode.all.min.js"><\/script>`);
            printWindow.document.write(
                '<script>' +
                'JsBarcode("#barcode", "' + barcode + '", { format: "CODE128", width: 1.5, height: 60 });' +
                'window.print();' +
                '<\/script>'
            );
            printWindow.document.write(`</body></html>`);

            // Update DB only if it was not printed before
            if (!isReprint) {
                $.post('@Url.Action("MarkBarcodePrinted", "Librarian")', {
                    barcode: barcode,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                })
                .done(function () {
                    dropdown.find('option:selected')
                        .text(barcode + " (Printed)")
                        .data('isprinted', true);

                    row.find('.print-status').html(`
                        <span class="badge bg-success">Printed</span>
                        <button class="btn btn-sm btn-outline-primary reprint-barcode-btn ms-2">Reprint</button>
                    `);
                });
            }
        });   // ✅ THIS was missing

        // ----------------------------------------------------------
        // ✅ Issue Selected Reserves
        // ----------------------------------------------------------
        $('#issueSelectedReserves').click(function () {
            var selected = [];
            $('.reserve-select:checked').each(function () {
                var circId = $(this).data('circid');
                var patronId = $(this).data('patronid');
                var barcode = $(this).closest('tr').find('.reserve-barcode').val();

                if (!barcode) {
                    showAlert('Please select a barcode for all selected items.', 'danger');
                    selected = [];
                    return false;
                }

                selected.push({ CirculationID: circId, PatronID: patronId, Barcode: barcode });
            });

            if (!selected.length) {
                showAlert('Select at least one reserve to issue.', 'warning');
                return;
            }

            window.selectedReserves = selected;
            $('#confirmIssueModal').modal('show');
        });

        // ----------------------------------------------------------
        // ✅ Confirm Issue
        // ----------------------------------------------------------
        $('#confirmIssueBtn').click(function () {
            var selectedRole = $('#roleSelect').val(); // ✅ get role from dropdown again
            var patronId = window.selectedReserves[0].PatronID;

            $.ajax({
                url: '@Url.Action("IssueSelectedReserves", "Librarian")',
                method: 'POST',
                data: {
                    selectedRole: selectedRole,
                    userId: patronId,
                    selectedReserves: window.selectedReserves,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (data) {
                    $('#confirmIssueModal').modal('hide');
                    if (data.success) {
                        showAlert('Selected materials issued successfully!', 'success');
                        setTimeout(() => location.reload(), 2500);
                    } else {
                        showAlert(data.message || 'Error issuing reserves.', 'danger');
                    }
                },
                error: function () {
                    $('#confirmIssueModal').modal('hide');
                    showAlert('An error occurred while issuing materials.', 'danger');
                }
            });
        });

        function showAlert(message, type) {
            var alertBox = $(`
                <div class="alert alert-${type} alert-dismissible fade show alert-floating">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`);
            $('#alertContainer').append(alertBox);
            setTimeout(() => alertBox.alert('close'), 4000);
        }
    });
    </script>

}

