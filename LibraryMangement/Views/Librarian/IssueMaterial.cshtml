@model IEnumerable<LibraryMangement.Models.IssuanceRequestViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Issuance Requests";
}

<h2>Issuance Requests</h2>

<div class="accordion" id="requestsAccordion">
    @foreach (var request in Model)
    {
        string collapseId = $"collapseRequest{request.RequestID}";

        <div class="accordion-item">
            <h2 class="accordion-header" id="heading@request.RequestID">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@collapseId">
                    Request ID: @request.RequestID - Patron: @request.PatronName - Date: @request.RequestDate.ToString("yyyy-MM-dd") - Status: @request.RequestStatus
                </button>
            </h2>

            <div id="@collapseId" class="accordion-collapse collapse">
                <div class="accordion-body">
                    <table class="table table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Material Title</th>
                                <th>Available Quantity</th>
                                <th>Account Number</th>
                                <th>Barcode Number</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in request.Items)
                            {
                                <tr>
                                    <td>@item.MaterialTitle</td>
                                    <td>@item.AvailableQuantity</td>
                                    <td>@item.AccountNumber</td>
                                    <td>@item.BarcodeNumber</td>
                                    <td>@item.Status</td>
                                </tr>
                            }
                        </tbody>
                    </table>

                    @if (request.RequestStatus == "Requested")
                    {
                        <form method="post" action="@Url.Action("ApproveIssuanceRequest", new { requestId = request.RequestID })">
                            <button type="submit" class="btn btn-success">Approve Request</button>
                        </form>
                    }
                    else
                    {
                        <span class="badge bg-success">Processed</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
