@model LibraryMangement.Models.MaterialViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Edit Material";
    var currentYear = DateTime.Now.Year;
}

<style>
    .form-container {
        background: #ffffff;
        padding: 35px 40px;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        margin: 40px auto;
        max-width: 1200px;
    }

        .form-container h2 {
            color: #0d6efd;
            font-weight: 700;
            text-align: center;
            margin-bottom: 25px;
        }

    .btn-primary {
        background: linear-gradient(90deg, #0d6efd, #6610f2);
        border: none;
        padding: 10px 25px;
        border-radius: 8px;
        font-weight: 600;
    }

        .btn-primary:hover {
            background: linear-gradient(90deg, #6610f2, #0d6efd);
        }

    .form-label {
        font-weight: 600;
        color: #333;
    }

    textarea.form-control {
        resize: vertical;
    }

    .success-overlay {
        background-color: rgba(255, 255, 255, 0.9);
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 1050;
    }
</style>

@if (TempData["Success"] != null)
{
    <div class="success-overlay d-flex align-items-center justify-content-center">
        <div class="text-center">
            <i class="bi bi-check-circle-fill display-2 text-success animate-pop"></i>
            <h5 class="mt-2 text-success fw-bold">@TempData["Success"]</h5>
        </div>
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger mb-2 text-center">@TempData["Error"]</div>
}

<div class="container form-container">
    <h2>Edit Material</h2>

    <form method="get" action="@Url.Action("ActiveIssued", "Librarian")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="MaterialID" value="@Model.MaterialID" />

        <div class="row g-4">
            <div class="col-md-4">
                <label class="form-label">Title</label>
                <input type="text" name="Title" class="form-control" value="@Model.Title" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Author</label>
                <input type="text" name="Author" class="form-control" value="@Model.Author" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Publisher</label>
                <input type="text" name="Publisher" class="form-control" value="@Model.Publisher" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Place of Publishers</label>
                <input type="text" name="PlaceofPublishers" class="form-control" value="@Model.PlaceofPublishers" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Year Published</label>
                <select name="YearPublished" class="form-control" required>
                    <option value="">Select Year</option>
                    @for (int year = currentYear; year >= 1940; year--)
                    {
                        <option value="@year" @(Model.YearPublished == year ? "selected" : "")>@year</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Edition</label>
                <select name="Edition" class="form-control">
                    <option value="">Select Edition</option>
                    @for (int i = 1; i <= 30; i++)
                    {
                        <option value="@i" @(Model.Edition == i.ToString() ? "selected" : "")>@i</option>
                    }
                </select>
            </div>

            <div class="col-md-4">
                <label class="form-label">Description</label>
                <textarea name="Description" class="form-control">@Model.Description</textarea>
            </div>

            <div class="col-md-4">
                <label class="form-label">Pages</label>
                <input type="number" name="Pages" class="form-control" value="@Model.Pages" min="1" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Vol</label>
                <input type="text" name="Vol" class="form-control" value="@Model.Vol" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Source</label>
                <input type="text" name="Source" class="form-control" value="@Model.Source" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Price</label>
                <input type="number" name="Price" class="form-control" step="0.01" value="@Model.Price" min="0" />
            </div>

            <div class="col-md-4">
                <label class="form-label">ISBN</label>
                <input type="text" name="ISBN" class="form-control" value="@Model.ISBN" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Available Quantity</label>
                <input type="number" name="AvailableQuantity" class="form-control" value="@Model.AvailableQuantity" required />
            </div>

            <div class="col-md-4">
                <label class="form-label">Total Quantity</label>
                <input type="number" name="TotalQuantity" class="form-control" value="@Model.TotalQuantity" required />
            </div>
        </div>

        <div class="text-center mt-4">
            <button type="submit" class="btn btn-primary">Save Changes</button>
        </div>
    </form>
</div>
