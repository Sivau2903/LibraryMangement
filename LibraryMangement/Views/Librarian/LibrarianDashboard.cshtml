@model LibraryMangement.Models.LibrarianDashboardViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Librarian Dashboard";
}

<h2 class="mb-4 text-primary fw-bold">Welcome to ICFAI Library Admin Dashboard</h2>

<div class="row g-3">

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-journal-bookmark fs-1 text-primary"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Total Materials</h6>
                <h3 class="fw-bold">@Model.TotalMaterials</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-people fs-1 text-success"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Total Patrons</h6>
                <h3 class="fw-bold">@Model.TotalPatrons</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-person-badge fs-1 text-info"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Total Librarians</h6>
                <h3 class="fw-bold">@Model.TotalLibrarians</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-book-half fs-1 text-warning"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Active Issued Books</h6>
                <h3 class="fw-bold">@Model.ActiveIssues</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-exclamation-circle fs-1 text-danger"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Overdue Issues</h6>
                <h3 class="fw-bold">@Model.OverdueIssues</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-clock-history fs-1 text-secondary"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Pending Reservations</h6>
                <h3 class="fw-bold">@Model.PendingReservations</h3>
            </div>
        </div>
    </div>

    <div class="col-lg-3 col-md-6 col-sm-6">
        <div class="card shadow-sm border-0 text-center p-3">
            <div class="card-body">
                <div class="mb-2">
                    <i class="bi bi-box-seam fs-1 text-dark"></i>
                </div>
                <h6 class="text-uppercase fw-semibold">Low Stock Materials</h6>
                <h3 class="fw-bold">@Model.MaterialsBelowStockLimit</h3>
            </div>
        </div>
    </div>

</div>
