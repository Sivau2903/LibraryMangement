@model IEnumerable<LibraryMangement.Models.IssuedReportViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Issued Materials Report";
}

<h2 class="text-center my-4">Active Issued List</h2>

<form method="get" action="@Url.Action("ActiveIssued", "Librarian")" class="row g-3 mb-4 align-items-end justify-content-between">
    <!-- Left: Role Filter -->
    <div class="col-md-2" style="width:10%">
        <label class="form-label">Role</label>
        <select name="selectedRole" class="form-select" id="roleSelect">
            <option value="Student" @(ViewBag.SelectedRole == "Student" ? "selected" : "")>Student</option>
            <option value="Faculty" @(ViewBag.SelectedRole == "Faculty" ? "selected" : "")>Faculty</option>
        </select>
    </div>

   
    <!-- Center: Date Filters + Buttons -->
    <div class="col-md-7 d-flex justify-content-center">
        <div class="d-flex align-items-end gap-3">
            <div>
                <label class="form-label mb-1">From</label>
                <input type="date" class="form-control form-control-sm" style="width:170px;" name="fromDate" value="@ViewBag.FromDate" />
            </div>
            <div>
                <label class="form-label mb-1">To</label>
                <input type="date" class="form-control form-control-sm" style="width:170px;" name="toDate" value="@ViewBag.ToDate" />
            </div>
            <div class="d-flex align-items-end gap-2">
                <button type="submit" class="btn btn-primary btn-sm">Filter</button>
                <a href="@Url.Action("IssuedReport", "Librarian")" class="btn btn-secondary btn-sm">Clear</a>
            </div>
        </div>
    </div>


</form>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No issued materials found for the selected filters.
    </div>
}
else
{
    <div style="height:calc(100vh - 250px); overflow-y:auto;">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark sticky-top">
                <tr>
                    <th>Patron Name</th>
                    <th>Book Title</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.Name</td>
                        <td>@record.MaterialTitle</td>
                        <td>@record.IssueDate</td>
                        <td>@record.DueDate</td>
                        <td style="color:@(record.Status == "Issued" ? "green" : "red"); font-weight:bold;">
                            @record.Status
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    <script>
        // Auto-submit when role changes
        document.getElementById('roleSelect').addEventListener('change', function () {
            this.form.submit();
        });
    </script>
}
