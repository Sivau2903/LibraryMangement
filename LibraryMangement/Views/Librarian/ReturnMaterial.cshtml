@model LibraryMangement.Models.ReturnMaterialViewModel

<h2 class="text-center my-4">Return / Renew Books</h2>

<div class="text-center mb-4">
    <div class="input-group justify-content-center" style="max-width:400px; margin:auto;">
        <input type="text" id="barcodeInput" class="form-control" placeholder="Scan or Enter Barcode Number" autofocus />
        <button type="button" id="searchBtn" class="btn btn-primary">Search</button>
    </div>
</div>

<div class="table-responsive" style="max-height:500px; overflow-y:auto;">
    <table id="returnTable" class="table table-bordered table-striped" style="display:none;">
        <thead class="table-dark" style="position:sticky; top:0; z-index:1;">
            <tr>
                <th>Barcode</th>
                <th>Title</th>
                <th>Patron Name</th>
                <th>Patron ID</th>
                <th>Email</th>
                <th>Patron Type</th>
                <th>Requested Date</th>
                <th>Issue Date</th>
                <th>Due Date</th>
                <th>Status</th>
                <th>Extra Fine</th>
                <th>Total Fine</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>

<p id="noDataMsg" class="text-center text-muted mt-4">No data found. Please scan a Barcode Number.</p>
@section Scripts {
    <script>
$(document).ready(function () {

    var fineReasons = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.FineReason));

    function formatDate(dateStr) {
        if (!dateStr) return "";
        var date = new Date(dateStr);
        if (isNaN(date)) return "";
        return date.toLocaleDateString('en-GB');
    }

    function showSuccess(msg) { alert(msg); }

    function addRow(record) {
        if ($("#row_" + record.BarcodeNumber).length) {
            showSuccess("This barcode is already added.");
            return;
        }

        let options = `<option value="">-- Select Reason --</option>`;
        fineReasons.forEach(r => {
            options += `<option value="${r.Value}" data-fine="${r.FinePerDay}">${r.ReasonText}</option>`;
        });

        let row = `
<tr id="row_${record.BarcodeNumber}">
    <td>${record.BarcodeNumber}</td>
    <td>${record.MaterialTitle}</td>
    <td>${record.PatronName}</td>
    <td>${record.PatronID}</td>
    <td>${record.PatronEmail}</td>
    <td>${record.PatronType}</td>
    <td>${formatDate(record.RequestedDate)}</td>
    <td>${formatDate(record.IssueDate)}</td>
    <td>${formatDate(record.DueDate)}</td>
    <td style="color:${record.Status==='Overdue'?'red':'black'}; font-weight:bold;">${record.Status}</td>
    <td>
        <select class="form-select extraFineSelect" data-basefine="${record.FineAmount}">
            ${options}
        </select>
    </td>
    <td>
        <input type="text" class="form-control fineAmountDisplay" value="${record.FineAmount.toFixed(2)}" readonly />
        <input type="hidden" class="fineAmountInput" value="${record.FineAmount.toFixed(2)}" />
        <input type="hidden" class="fineReasonInput" />
    </td>
    <td>
        <form method="post" action="/Librarian/ProcessReturnRenew">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CirculationID" value="${record.CirculationID}" />
            <input type="hidden" name="action" class="actionType" />
            <input type="hidden" name="paymentStatus" class="paymentStatus" />
            <input type="hidden" name="fineAmount" class="fineAmountInputForm" value="${record.FineAmount.toFixed(2)}" />
            <input type="hidden" name="FineReason" class="fineReasonInputForm" />
            <button type="button" class="btn btn-success btn-sm" onclick="confirmAndSubmit(this,'ReturnPaid')">Return & Paid</button>
            <button type="button" class="btn btn-danger btn-sm" onclick="confirmAndSubmit(this,'ReturnUnpaid')">Return & Unpaid</button>
            <button type="button" class="btn btn-warning btn-sm" onclick="confirmAndSubmit(this,'Renew')">Renew</button>
        </form>
    </td>
</tr>
        `;
        $("#returnTable tbody").append(row);
        $("#returnTable").show();
        $("#noDataMsg").hide();
    }

    function searchBarcode() {
        var barcode = $("#barcodeInput").val().trim();
        if (!barcode) { alert("Please scan or enter barcode."); return; }

        $.getJSON( '@Url.Action("GetReturnDetailsByBarcode", "Librarian", new { area = "" })', { barcode: barcode }, function(res){
            if(res.success) addRow(res.record);
            else alert(res.message);
            $("#barcodeInput").val('').focus();
        }).fail(function(){ alert("Error fetching data."); $("#barcodeInput").val('').focus(); });
    }

    $("#searchBtn").click(searchBarcode);
    $("#barcodeInput").keypress(function(e){
        if(e.which===13){ searchBarcode(); e.preventDefault(); }
    });

    // Extra fine change
    $(document).on('change', '.extraFineSelect', function () {
        var row = $(this).closest('tr');
        var baseFine = parseFloat($(this).data('basefine')) || 0;
        var extraFine = parseFloat($(this).find(':selected').data('fine')) || 0;
        var totalFine = baseFine + extraFine;

        row.find('.fineAmountDisplay').val(totalFine.toFixed(2));
        row.find('.fineAmountInput').val(totalFine.toFixed(2));
        row.find('.fineReasonInput').val($(this).val());
        row.find('.fineAmountInputForm').val(totalFine.toFixed(2));
        row.find('.fineReasonInputForm').val($(this).val());
    });

    // Confirmation popup before submitting each row
    window.confirmAndSubmit = function(button, type) {
        var confirmMsg = "";
        if (type === 'ReturnPaid') confirmMsg = "Are you sure you want to Return this book and mark as Paid?";
        else if (type === 'ReturnUnpaid') confirmMsg = "Are you sure you want to Return this book and mark as Unpaid?";
        else confirmMsg = "Are you sure you want to Renew this book?";

        // ✅ Show a custom styled confirmation popup
        if (confirm(confirmMsg)) {
            var form = $(button).closest('form');

            if(type==='ReturnPaid'){ form.find('.actionType').val('Return'); form.find('.paymentStatus').val('Paid'); }
            else if(type==='ReturnUnpaid'){ form.find('.actionType').val('Return'); form.find('.paymentStatus').val('Unpaid'); }
            else { form.find('.actionType').val('Renew'); form.find('.paymentStatus').val(''); }

            form.submit();
        }
    };

});
    </script>
}

