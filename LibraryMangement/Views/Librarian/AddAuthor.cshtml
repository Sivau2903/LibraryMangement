@model List<LibraryMangement.Models.Author>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Manage Authors";
}

<h2 class="text-center my-4">Manage Authors</h2>
<style>
    @@media (min-width: 768px) {
        .col-md-5 {
            flex: 0 0 auto;
            width: 32.666667%;
            height: 270px;
        }
    }
    @@media (min-width: 768px) {
    .col-md-7 {
        flex: 0 0 auto;
        width: 58.33333333%;
        margin-top: -35px;
    }
}
</style>
<div class="row">
    <!-- Left: Existing Authors Table -->
    <div class="col-md-7">
        <h4>Existing Authors</h4>
        <div style="max-height: 650px; overflow-y: auto; border: 1px solid #ddd; border-radius: 10px; padding: 10px;">
            @if (Model != null && Model.Count > 0)
            {
                <table class="table table-striped table-bordered mb-0">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Author Name</th>
                            <th>Action</th>
                            <th>(Click to make Active/InActive)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            <tr id="row-@Model[i].AuthorID">
                                <td>@(i + 1)</td>
                                <td>
                                    <input type="text" class="form-control form-control-sm author-name-input"
                                           value="@Model[i].Name" data-id="@Model[i].AuthorID" />
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-success btn-sm save-author-btn" data-id="@Model[i].AuthorID">Save</button>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm toggle-author-status-btn"
                                            data-id="@Model[i].AuthorID"
                                            data-status="@Model[i].IsActive"
                                            style="width: 80px; color: white; font-weight: bold;">
                                        @(Model[i].IsActive ? "Active" : "Inactive")
                                    </button>
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <p class="text-muted text-center mb-0">No authors added yet.</p>
            }
        </div>
    </div>

    <!-- Right: Add Author Form Card -->
    <div class="col-md-5 d-flex justify-content-end">
        <div class="card shadow-sm" style="width: 80%; border-radius: 15px;">
            <div class="card-body">
                <h4 class="card-title mb-3 text-primary">Add New Author</h4>

                <!-- Alerts -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <form id="addAuthorForm" method="post" action="@Url.Action("AddAuthor", "Librarian")">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Author Name</label>
                        <input type="text" id="NewAuthorName" class="form-control" name="AuthorName" placeholder="Enter author name" required />
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-primary" id="addAuthorConfirmBtn">Add Author</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="confirmModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalConfirmBtn">Yes, Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css" />
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
        $(document).ready(function () {
            var currentEditId = 0;
            var currentNewName = "";

            // Autocomplete for Add Author
            $("#NewAuthorName").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("GetAuthors", "Librarian")',
                        type: 'GET',
                        data: { term: request.term },
                        success: function (data) { response(data); }
                    });
                },
                minLength: 2
            });

            // Save edited author name
            $(".save-author-btn").click(function () {
                currentEditId = $(this).data("id");
                var newName = $(this).closest("tr").find(".author-name-input").val();
                currentNewName = newName;

                if (!newName) { alert("Author name cannot be empty!"); return; }

                $("#confirmModalBody").text("Are you sure you want to save changes to this Author?");
                $("#confirmModal").modal("show");

                $("#modalConfirmBtn").off("click").on("click", function () {
                    $.ajax({
                        url: '/Librarian/UpdateAuthor',
                        type: 'POST',
                        data: {
                            id: currentEditId,
                            authorName: currentNewName,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                $('#row-' + currentEditId).find('.author-name-input').val(currentNewName);
                                alert("Author updated successfully!");
                            } else { alert("Error: " + response.message); }
                            $("#confirmModal").modal("hide");
                        },
                        error: function (xhr) {
                            alert("An error occurred: " + xhr.responseText);
                            $("#confirmModal").modal("hide");
                        }
                    });
                });
            });

            // Add new author confirmation
            $("#addAuthorConfirmBtn").click(function () {
                var name = $("#NewAuthorName").val().trim();
                if (!name) { alert("Please enter an Author name!"); return; }

                currentNewName = name;
                $("#confirmModalBody").text("Are you sure you want to add this new Author?");
                $("#confirmModal").modal("show");

                $("#modalConfirmBtn").off("click").on("click", function () {
                    $("#addAuthorForm").submit();
                });
            });

            // Function to set button color based on status
            function setStatusButtonColor(button, status) {
                if (status) {
                    button.css("background-color", "green");
                    button.css("border-color", "green");
                } else {
                    button.css("background-color", "red");
                    button.css("border-color", "red");
                }
            }

            $(".toggle-author-status-btn").each(function () {
                var status = $(this).data("status") === true || $(this).data("status") === "True";
                setStatusButtonColor($(this), status);
            });

            // Toggle Author Active/Inactive
            $(".toggle-author-status-btn").click(function () {
                var button = $(this);
                var id = button.data("id");
                var currentStatus = button.data("status") === true || button.data("status") === "True";
                var newStatus = !currentStatus;

                var confirmText = newStatus ? "activate" : "deactivate";
                $("#confirmModalBody").text("Are you sure you want to " + confirmText + " this Author?");
                $("#confirmModal").modal("show");

                $("#modalConfirmBtn").off("click").on("click", function () {
                    $.ajax({
                        url: '/Librarian/ToggleAuthorStatus',
                        type: 'POST',
                        data: {
                            id: id,
                            __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                        },
                        success: function (response) {
                            if (response.success) {
                                button.text(newStatus ? "Active" : "Inactive");
                                button.data("status", newStatus);
                                setStatusButtonColor(button, newStatus);
                                alert("Status updated successfully!");
                            } else {
                                alert("Error: " + response.message);
                            }
                            $("#confirmModal").modal("hide");
                        },
                        error: function (xhr) {
                            alert("An error occurred: " + xhr.responseText);
                            $("#confirmModal").modal("hide");
                        }
                    });
                });
            });



        });
    </script>
}
