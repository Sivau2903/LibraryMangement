@{
    ViewBag.Title = "Assign Role";
}

<div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
    <div class="card shadow-lg p-4" style="width: 450px; border-radius: 15px;">
        <h3 class="text-center mb-4 text-primary">Assign Role to Employee</h3>

        @using (Html.BeginForm("AssignRole", "Librarian", FormMethod.Post, new { id = "assignRoleForm" }))
        {
            @Html.AntiForgeryToken()

            <div class="form-group mb-3">
                <label class="fw-bold">Employee</label>
                @Html.DropDownList("employeeId", (SelectList)ViewBag.Employees, "Select Employee",
                    new { @class = "form-control" })
            </div>

            <div class="form-group mb-3">
                <label class="fw-bold">Role</label>
                @Html.DropDownList("roleId", (SelectList)ViewBag.Roles, "Select Role",
                    new { @class = "form-control" })
            </div>

            <div class="text-center">
                <button type="button" class="btn btn-primary px-4" id="assignRoleBtn">Assign Role</button>
            </div>
        }

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success mt-3">@TempData["Success"]</div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger mt-3">@TempData["Error"]</div>
        }
    </div>
</div>

<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="confirmModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">
                Are you sure you want to assign this role to the employee?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalConfirmBtn">Yes, Assign</button>
            </div>
        </div>
    </div>
</div>

<style>
    .form-control {
        border-radius: 8px;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Show modal when Assign Role button is clicked
            $("#assignRoleBtn").click(function () {
                $("#confirmModal").modal("show");
            });

            // Submit form if confirmed
            $("#modalConfirmBtn").click(function () {
                $("#assignRoleForm").submit();
            });
        });
    </script>
}
