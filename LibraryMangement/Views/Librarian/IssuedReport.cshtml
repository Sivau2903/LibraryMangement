@model IEnumerable<LibraryMangement.Models.IssuedReportViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Issued Materials Report";
}

<h2 class="text-center my-4">Issued Materials Report</h2>

<form method="get" action="@Url.Action("IssuedReport", "Librarian")" class="row g-3 mb-4 align-items-end">
    <div class="col-md-2">
        <label class="form-label">From Date</label>
        <input type="date" class="form-control" name="fromDate" value="@ViewBag.FromDate" />
    </div>
    <div class="col-md-2">
        <label class="form-label">To Date</label>
        <input type="date" class="form-control" name="toDate" value="@ViewBag.ToDate" />
    </div>
    <div class="col-md-2">
        <label class="form-label">Role</label>
        <select name="selectedRole" class="form-select">
            <option value="Student" @(ViewBag.SelectedRole == "Student" ? "selected" : "")>Student</option>
            <option value="Faculty" @(ViewBag.SelectedRole == "Faculty" ? "selected" : "")>Faculty</option>
        </select>
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="@Url.Action("IssuedReport", "Librarian")" class="btn btn-secondary">Clear</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No issued materials found for the selected filters.
    </div>
}
else
{
    <div style="height:calc(100vh - 250px); overflow-y:auto;">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark sticky-top">
                <tr>
                    <th>Patron Name</th>
                    <th>Book Title</th>
                    <th>Issue Date</th>
                    <th>Due Date</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.Name</td>
                        <td>@record.MaterialTitle</td>
                        <td>@record.IssueDate?.ToString("dd-MM-yyyy")</td>
                        <td>@record.DueDate?.ToString("dd-MM-yyyy")</td>
                        <td style="color:@(record.Status == "Issued" ? "green" : "red"); font-weight:bold;">
                            @record.Status
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
