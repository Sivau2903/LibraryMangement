@model  LibraryMangement.Models.WalkInIssueVM
@{
    ViewBag.Title = "Issue Book";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h4>Issue Book</h4>
<div class="card p-3">
    @using (Html.BeginForm("IssueForm", "Librarian", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.MaterialID)
        @Html.HiddenFor(m => m.CopyID)
        @Html.HiddenFor(m => m.UniversityID)
        @Html.HiddenFor(m => m.SchoolID)
        @Html.HiddenFor(m => m.IssuedBy)

        <div class="col-md-3">
            <label class="form-label fw-semibold">User Type</label>
            <select id="UserType" name="UserType" class="form-select shadow-sm">
                <option value="Student">Student</option>
                <option value="Faculty">Faculty</option>
            </select>
        </div>
                                      
        <div class="col-md-3">
            <label id="UserIdentifierLabel" class="form-label fw-semibold">Enrollment Number</label>
            <input type="text" id="UserIdentifier" name="UserIdentifier"
                   class="form-control shadow-sm" required />
        </div>


        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Barcode</label>
                @Html.TextBoxFor(m => m.BarcodeNumber, new { @class = "form-control", @readonly = "readonly" })
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Issued Date</label>
                @Html.TextBoxFor(m => m.IssuedDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", required = "required" })
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Due Date</label>
                @Html.TextBoxFor(m => m.DueDate, "{0:yyyy-MM-ddTHH:mm}", new { @class = "form-control", type = "datetime-local", required = "required" })
            </div>
        </div>

        <button type="submit" class="btn btn-success">Confirm Issue</button>
        <a href="@Url.Action("WalkInIssue","Librarian")" class="btn btn-secondary ms-2">Cancel</a>
    }
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <script>
        $(document).ready(function () {

            // Change label for student/faculty
            $('#UserType').change(function () {
                $('#UserIdentifierLabel').text($(this).val() === "Student" ? "Enrollment Number" : "Employee ID");
            });
        });
    </script>
}


