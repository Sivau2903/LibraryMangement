@model IEnumerable<LibraryMangement.Models.OverdueReportViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Overdue Reports";
}
<style>
    @@media (min-width: 768px) {
    .col-md-3 {
        flex: 0 0 auto;
        width: 13%;
    }
}
</style>

<h2 class="text-center my-4">Overdue Materials Report</h2>

<form method="get" action="@Url.Action("OverdueReports", "Librarian")" class="row g-3 mb-4">
    <div class="col-md-3" style="width:12%">
        <label class="form-label">From Date</label>
        <input type="date" class="form-control" name="fromDate" value="@Request.QueryString["fromDate"]" />
    </div>
    <div class="col-md-3" style="width:12%">
        <label class="form-label">To Date</label>
        <input type="date" class="form-control" name="toDate" value="@Request.QueryString["toDate"]" />
    </div>
    <div class="col-md-3 align-self-end">
        <button type="submit" class="btn btn-primary">Filter</button>
        <a href="@Url.Action("OverdueReports", "Librarian")" class="btn btn-secondary">Clear</a>
    </div>
</form>

<div style="height:calc(100vh - 200px); overflow-y:auto;">
    <table class="table table-bordered table-striped table-hover">
        <thead class="table-dark sticky-top">
            <tr>
                <th>Patron Name</th>
                <th>Book Title</th>
                <th>Due Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var record in Model)
            {
                <tr>
                    <td>@record.StudentName</td>
                    <td>@record.MaterialTitle</td>
                    <td>@record.DueDate</td>
                    <td style="color:@(record.Status == "Overdue" ? "red" : "red"); font-weight:bold;">
                        @record.Status
                    </td>
                </tr>
            }
        </tbody>
    </table>
    </div>