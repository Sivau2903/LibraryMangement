@model List<LibraryMangement.Models.FineReason>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Add / Update Fine Reason";
}

<h2 class="text-center my-4">Manage Fines</h2>

<div class="row justify-content-center">
    <!-- Left side: Existing Fine Reasons -->
    <div class="col-md-5">
        <h4>Existing Fines</h4>
        <div class="table-responsive">
            <table class="table table-bordered table-striped shadow-sm rounded">
                <thead class="table-light text-center">
                    <tr>
                        <th>Reason</th>
                        <th>Fine Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.Reason</td>
                                <td>@item.FineAmount</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="2" class="text-center text-muted">No fine reasons added yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Right side: Add / Update Form -->
    <div class="col-md-4">
        <div class="card shadow rounded-3">
            <div class="card-header bg-primary text-white text-center">
                <h5 class="mb-0">Fine Management</h5>
            </div>

            <div class="card-body">
                <ul class="nav nav-tabs mb-3" id="fineTab" role="tablist">
                    <li class="nav-item flex-fill text-center">
                        <button class="nav-link active w-100" id="update-tab" data-bs-toggle="tab" data-bs-target="#updateFine" type="button" role="tab">
                            Update Fine
                        </button>
                    </li>
                    <li class="nav-item flex-fill text-center">
                        <button class="nav-link w-100" id="add-tab" data-bs-toggle="tab" data-bs-target="#addFine" type="button" role="tab">
                            Add New Fine
                        </button>
                    </li>
                </ul>

                <div class="tab-content">
                    <!-- Update Fine Tab -->
                    <div class="tab-pane fade show active" id="updateFine" role="tabpanel">
                        <form method="post" action="@Url.Action("AddFineReason", "Librarian")">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-bold">Select Existing Reason</label>
                                <select class="form-select" id="existingReason" name="ReasonText" onchange="fillReasonText()">
                                    <option value="">-- Select existing reason --</option>
                                    @foreach (var reason in Model)
                                    {
                                        <option value="@reason.Reason" data-amount="@reason.FineAmount">@reason.Reason</option>
                                    }
                                </select>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Fine Amount</label>
                                <input type="number" class="form-control" id="FineAmount" name="FineAmount" step="0.01" placeholder="Enter fine amount" required />
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-primary w-100">Update Fine</button>
                            </div>
                        </form>
                    </div>

                    <!-- Add New Fine Tab -->
                    <div class="tab-pane fade" id="addFine" role="tabpanel">
                        <form method="post" action="@Url.Action("AddFineReason", "Librarian")">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label class="form-label fw-bold">Fine Reason</label>
                                <input type="text" class="form-control" name="ReasonText" placeholder="Enter fine reason" required />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-bold">Fine Amount</label>
                                <input type="number" class="form-control" name="FineAmount" step="0.01" placeholder="Enter fine amount" required />
                            </div>

                            <div class="text-end">
                                <button type="submit" class="btn btn-success w-100">Add Fine</button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- Success or Error Message with Close Button -->
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                        @Html.ValidationSummary()
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
<!-- Confirmation Modal -->
<div class="modal fade" id="confirmModal" tabindex="-1" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="confirmModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="confirmModalBody">
                Are you sure you want to proceed?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="modalConfirmBtn">Yes, Confirm</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function fillReasonText() {
            var selected = document.getElementById("existingReason");
            var selectedOption = selected.options[selected.selectedIndex];
            var amount = selectedOption?.getAttribute("data-amount");
            document.getElementById("FineAmount").value = amount || '';
        }

        $(document).ready(function () {
            var currentForm; // to store which form is submitting

            // Update Fine confirmation
            $("#updateFine form").submit(function (e) {
                e.preventDefault();
                currentForm = this;
                $("#confirmModalBody").text("Are you sure you want to update this Fine Reason?");
                $("#confirmModal").modal("show");
            });

            // Add Fine confirmation
            $("#addFine form").submit(function (e) {
                e.preventDefault();
                currentForm = this;
                $("#confirmModalBody").text("Are you sure you want to add this Fine Reason?");
                $("#confirmModal").modal("show");
            });

            // Confirm button in modal
            $("#modalConfirmBtn").click(function () {
                if (currentForm) {
                    currentForm.submit();
                }
            });
        });
    </script>
}

