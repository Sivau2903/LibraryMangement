
@model IEnumerable<LibraryMangement.Models.RequestReportViewModel>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Requested Materials Report";
}

<h2 class="text-center my-4">Requested Materials Report</h2>

<form method="get" action="@Url.Action("RequestReport", "Librarian")" class="row align-items-end mb-4">
    <!-- Left: Role Filter -->
    <div class="col-md-3 d-flex align-items-end" style="width:10%">
        <div class="w-100">
            <label class="form-label">Role</label>
            <select id="roleSelect" name="selectedRole" class="form-select">
                <option value="Student" @(ViewBag.SelectedRole == "Student" ? "selected" : "")>Student</option>
                <option value="Faculty" @(ViewBag.SelectedRole == "Faculty" ? "selected" : "")>Faculty</option>
            </select>
        </div>
    </div>

    <!-- Right: Date Filters + Buttons -->
    <div class="col-md-9 d-flex justify-content-end align-items-end flex-wrap gap-2">
        <div>
            <label class="form-label">From Date</label>
            <input type="date" class="form-control" name="fromDate" value="@Request.QueryString["fromDate"]" style="width: 160px;" />
        </div>
        <div>
            <label class="form-label">To Date</label>
            <input type="date" class="form-control" name="toDate" value="@Request.QueryString["toDate"]" style="width: 160px;" />
        </div>
        <div class="d-flex align-items-end">
            <button type="submit" class="btn btn-primary me-2">Filter</button>
            <a href="@Url.Action("RequestReport", "Librarian")" class="btn btn-secondary">Clear</a>
        </div>
    </div>
</form>



@if (!Model.Any())
{
    <div class="alert alert-info text-center">
        No requested materials found for the selected role and date range.
    </div>
}
else
{
    <div style="height:calc(100vh - 200px); overflow-y:auto;">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark sticky-top">
                <tr>
                    <th>Requested Date</th>
                    <th>Requested By</th>
                    <th>Book Title</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var record in Model)
                {
                    <tr>
                        <td>@record.RequestedDate</td>
                        <td>@record.UserName</td>
                        <td>@record.MaterialTitle</td>
                        <td>
                            <span class="badge @(record.Status == "Requested" ? "bg-warning text-dark" : "bg-success")">
                                @record.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
@section Scripts {
    <script>
        // Auto-submit when role changes
        document.getElementById('roleSelect').addEventListener('change', function () {
            this.form.submit();
        });
    </script>
}
