@model LibraryMangement.Models.tblLibrary
@{
    ViewBag.Title = "Create Library";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container mt-4">

    <div class="row">
        <div class="col-md-8">

            <div class="card shadow p-4">
                <h4 class="text-primary mb-3">Libraries Created</h4>

                <table class="table table-bordered table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Library Name</th>
                            <th>Librarian Name</th>
                            <th>Created Date</th>
                            <th>Is Active</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var lib in (IEnumerable<LibraryMangement.Models.LibraryListViewModel>)ViewBag.LibraryList)
                        {
                            <tr>
                                <td>@lib.LibraryName</td>
                                <td>@lib.LibrarianName</td>
                                <td>@lib.CreatedDate.ToString("dd-MMM-yyyy")</td>
                                <td>
                                    @if (lib.IsActive)
                                    {
                                        <span class="badge bg-success">Active</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactive</span>
                                    }
                                    </td>
</tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

        <!-- LIBRARY LIST SECTION -->
        <div class="col-md-4">
            
            <div class="card shadow p-4 mb-4">
                <h3 class="text-primary mb-4 text-center">Create New Library</h3>

                @using (Html.BeginForm("CreateLibrary", "Admin", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success mb-2">@TempData["Success"]</div>
                    }

                    <div class="mb-3">
                        <label class="form-label">University ID</label>
                        <input type="text" class="form-control" value="@ViewBag.UniversityID" readonly />
                        @Html.HiddenFor(m => m.UniversityID, new { Value = ViewBag.UniversityID })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Library Name</label>
                        @Html.TextBoxFor(m => m.LibraryName, new { @class = "form-control", placeholder = "Enter Library Name" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Assign Librarian</label>
                        @Html.DropDownListFor(m => m.LibrarianUserID, (SelectList)ViewBag.Librarians,
                        "Select Librarian", new { @class = "form-select" })
                    </div>

                    <button type="submit" class="btn btn-success w-100">Create Library</button>
                }
            </div>
        </div>
    </div>

</div>
